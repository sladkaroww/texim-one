---
import Base from '../layouts/Base.astro';

const title = 'The Power of Authority | TEXIM ONE';
const description = 'Build your reputation, raise your standing, and set the direction for the community.';
---
<Base title={title} description={description} active="ranks" path="/ranks.html">
  <section class="hero hero--inner">
    <div class="hero-bg" style="background-image:url('https://i.ibb.co/CKpZkbnP/ets2-20250308-220351-00.png');"></div>
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title" data-i18n="nav.ranks">Ranks</h1>
        <p class="hero-subtitle" data-i18n="ranks.sub">The Power of Authority.</p>
      </div>
    </div>
  </section>

<section class="section section--white">
  <div class="container text-center">
    
    <!-- Заглавие на секцията -->
    <h2 class="section-title">Reputation Points</h2>
    
    <!-- Контейнер за снимката -->
    <div class="full-image-wrapper">
      <img 
        src="https://i.ibb.co/rK9dNWzz/Gemini-Generated-Image-7ib7ot7ib7ot7ib7.jpg" 
        alt="Reputation Points" 
        class="full-size-image"
      />
    </div>

  </div>
</section>

<style>
  /* Контейнер за центриране и подравняване */
  .full-image-wrapper {
    width: 100%;
    max-width: 1200px; /* Ширина, съответстваща на таблицата */
    margin: 20px auto 0;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    background-color: #ffffff;
  }

  /* Настройки за показване на снимката в пълен размер */
  .full-size-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
</style>

<section class="section section--white">
  <div class="container text-center">
    
    <!-- Заглавие на секцията -->
    <h2 class="section-title">Google Sheet</h2>
    
    <!-- Разпънат контейнер за таблицата -->
    <div class="full-table-wrapper">
      <iframe 
        id="liveGoogleSheet"
        src="about:blank" 
        scrolling="no">
      </iframe>
    </div>

  </div>
</section>

<style>
  .full-table-wrapper {
    width: 100%;
    max-width: 1200px; /* Разпъване по ширина */
    margin: 20px auto 0;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    background-color: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .full-table-wrapper iframe {
    width: 100%;
    height: 1200px; /* Регулирайте спрямо редовете */
    border: none;
    display: block;
    overflow: hidden;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const iframe = document.getElementById('liveGoogleSheet');
    const baseUrl = "https://docs.google.com/spreadsheets/d/e/2PACX-1vSpsfoa5PWmppRtGeUQV_h0e4f2QpXFKDRRrHnl0yCBwrWCIIaQBo06YvNajSazidWlSxvOQ9Vj-ive/pubhtml";
    
    // Добавяме уникален параметър (timestamp), за да избегнем кеширането от браузъра
    const freshUrl = baseUrl + "?widget=false&headers=false&chrome=false&t=" + new Date().getTime();
    
    iframe.src = freshUrl;
  });
</script>
