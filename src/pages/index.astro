---
import Base from '../layouts/Base.astro';

const title = 'TEXIM ONE — Bulgarian VTC for TruckersMP';
const description = 'TEXIM ONE is a Bulgarian virtual trucking company in TruckersMP — weekly convoys, real-rules driving, and a tight community since 2019.';
---
<Base title={title} description={description} active="home" path="/">
  <link rel="stylesheet" href="/css/mobile.css" slot="head" />
  <section class="hero hero-with-truck">
    <div class="hero-bg" style="background-image:url('https://files.catbox.moe/g9j45t.jpg');"></div>
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-row">
        <div class="hero-content" style="display:flex;flex-direction:column;gap:20px;">
          <h1 class="hero-title text-effect" data-text-effect="per-word" data-text-preset="blur" style="font-size:2.2rem;line-height:1.2;margin:0;">"Always 1 in mind, behind TEXIM!"</h1>
          <p class="hero-text" style="margin:0;line-height:1.5;"><a href="https://trucksbook.eu/company/218511" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;">TEXIM ONE</a> was launched on January 1, 2026, as a natural extension of <a href="https://trucksbook.eu/company/39218" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;">TEXIM</a>, which was founded on March 10, 2019.</p>
          <p class="hero-subtitle" style="margin:0;line-height:1.2;">VTC - Virtual Trucking Company</p>
          <div class="hero-btns" style="margin:0;padding:0;">
            <a href="https://discord.com/invite/2sSKVXUtn" class="btn btn-outline" data-i18n="hero.discord" target="_blank" rel="noopener">Discord Server</a>
          </div>
        </div>
        <div class="hero-truck" aria-hidden="true"><img src="https://files.catbox.moe/kf8238.png" alt="TEXIM ONE Truck" class="hero-truck-img" /></div>
      </div>
    </div>
  </section>

<section class="section section--light">
  <div class="container text-center">
    <h2 class="section-title">Vehicle Fleet</h2>
    <p class="section-subtitle">Required for formal events.</p>

    <div class="fleet-grid-5">
      <!-- 1. VOLVO FH6 -->
      <div class="fleet-card-item">
        <div class="fleet-card-header">
          <div class="fleet-img-wrap">
            <img src="https://i.ibb.co/BHP4VntG/ets2-20260907-165303-00-Photoroom.png" alt="Volvo FH6 Aero" loading="lazy" decoding="async" />
          </div>
          <span class="fleet-type-badge">TRUCK</span>
        </div>
        
        <div class="fleet-card-content">
          <div class="specs-grid-3">
            <div class="spec-card">
              <div class="spec-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1 .4-1 1v7c0 .6.4 1 1 1h2"></path><circle cx="7" cy="17" r="2"></circle><path d="M9 17h6"></path><circle cx="17" cy="17" r="2"></circle></svg>
              </div>
              <span class="spec-value">Volvo FH6 Aero</span>
              <span class="spec-label">SERIES</span>
            </div>

            <div class="spec-card">
              <div class="spec-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
              </div>
              <span class="spec-value">780 HP</span>
              <span class="spec-label">ENGINE</span>
            </div>

            <div class="spec-card">
              <div class="spec-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
              </div>
              <span class="spec-value">Vision</span>
              <span class="spec-label">PAINT JOB</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. MAN TGX -->
      <div class="fleet-card-item">
        <div class="fleet-card-header">
          <div class="fleet-img-wrap">
            <img src="https://i.ibb.co/cGJCCsk/ets2-20260907-165324-00-Photoroom.png" alt="MAN TGX GX" loading="lazy" decoding="async" />
