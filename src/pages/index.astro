              <span class="spec-lbl">SERIES</span>
            </div>
            <div class="spec-box">
              <div class="spec-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              </div>
              <span class="spec-val">770 HP</span>
              <span class="spec-lbl">ENGINE POWER</span>
            </div>
            <div class="spec-box">
              <div class="spec-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/></svg>
              </div>
              <span class="spec-val">Vision</span>
              <span class="spec-lbl">PAINT JOB</span>
            </div>
          </div>
        </div>

        <!-- 5. KÄSSBOHRER K.SCS -->
        <div class="card-item">
          <div class="card-header-info">
            <h3 class="card-title">Kässbohrer K.SCS</h3>
            <span class="card-subtitle">TEXIM ONE</span>
          </div>
          <div class="card-img-holder">
            <img src="https://i.ibb.co/vxKYQh50/ets2-20260907-185901-00-Photoroom.png" alt="Kässbohrer Trailer" />
          </div>
          <div class="card-specs-row">
            <div class="spec-box">
