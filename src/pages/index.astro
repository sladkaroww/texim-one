      </div>
    </div>

    <!-- Индикатор за точките отдолу -->
    <div class="carousel-dots" id="carouselDots">
      <span class="dot active" onclick="goToSlide(0)"></span>
      <span class="dot" onclick="goToSlide(1)"></span>
      <span class="dot" onclick="goToSlide(2)"></span>
      <span class="dot" onclick="goToSlide(3)"></span>
      <span class="dot" onclick="goToSlide(4)"></span>
    </div>

  </div>
</section>

<style>
  .fleet-carousel-section {
    padding: 50px 0;
    background-color: #ffffff;
    overflow: hidden;
  }

  .carousel-wrapper {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 30px 0;
  }

  .carousel-track {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Дизайн на картата */
  .card-item {
    flex: 0 0 350px;
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 20px;
    padding: 24px;
    box-sizing: border-box;
    transition: transform 0.5s ease, opacity 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease;
    opacity: 0.5;
    transform: scale(0.88);
  }

  .card-item.active {
    opacity: 1;
    transform: scale(1.05);
    border-color: #000000;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .card-header-info {
    text-align: left;
    margin-bottom: 16px;
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #000000;
    margin: 0;
  }

  .card-subtitle {
    font-size: 0.75rem;
    font-weight: 600;
    color: #999999;
    letter-spacing: 0.5px;
  }

  /* Кутия със снимката */
  .card-img-holder {
    background: #f4f4f6;
    border-radius: 14px;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    margin-bottom: 20px;
  }

  .card-img-holder img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* 3-те квадратчета за спецификации */
  .card-specs-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .spec-box {
    background: #f8f9fa;
    border: 1px solid #eeeeee;
    border-radius: 10px;
    padding: 10px 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .spec-icon {
    width: 26px;
    height: 26px;
    background: #000000;
    color: #ffffff;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
  }

  .spec-val {
    font-size: 0.75rem;
    font-weight: 700;
    color: #000000;
    line-height: 1.1;
    margin-bottom: 2px;
  }

  .spec-lbl {
    font-size: 0.55rem;
    font-weight: 600;
    color: #888888;
  }

  /* Индикатор с точки */
  .carousel-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
  }

  .dot {
    width: 10px;
    height: 10px;
    background-color: #dddddd;
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .dot.active {
    background-color: #000000;
    transform: scale(1.3);
  }
</style>

<script>
  let currentIndex = 0;
  const cards = document.querySelectorAll('.card-item');
  const dots = document.querySelectorAll('.dot');
  const track = document.getElementById('carouselTrack');
  const totalSlides = cards.length;
  let autoSlideInterval;

  function updateCarousel() {
    cards.forEach((card, index) => {
      if (index === currentIndex) {
        card.classList.add('active');
      } else {
        card.classList.remove('active');
      }
    });

    dots.forEach((dot, index) => {
      dot.classList.toggle('active', index === currentIndex);
    });

    // Изчисляване на отместването за центриране
    const cardWidth = 350 + 24; // ширина + gap
    const offset = -(currentIndex * cardWidth);
    track.style.transform = `translateX(${offset}px)`;
  }

  function goToSlide(index) {
    currentIndex = index;
    updateCarousel();
    resetAutoSlide();
  }

  function nextSlide() {
    currentIndex = (currentIndex + 1) % totalSlides;
    updateCarousel();
  }

  function startAutoSlide() {
    autoSlideInterval = setInterval(nextSlide, 4000); // смяна на всеки 4 секунди
  }

  function resetAutoSlide() {
    clearInterval(autoSlideInterval);
    startAutoSlide();
  }

  // Инициализация
  updateCarousel();
  startAutoSlide();
</script>

  <section class="section" style="padding-top:1.5rem;padding-bottom:1.5rem;">
    <div class="container">
      <h2 class="section-title" data-i18n="stats.title" style="margin:0 0 1.2rem 0;">Statistics</h2>
      <div class="stats-grid" style="margin-top:0;">
        <div class="stat-card"><div class="stat-number">10+</div><div class="stat-label" data-i18n="stat.drivers">Employees</div></div>
        <div class="stat-card"><div class="stat-number">7+</div><div class="stat-label" data-i18n="stat.founded">Years experience</div></div>
        <div class="stat-card"><div class="stat-number">9+</div><div class="stat-label" data-i18n="stat.km">Mln WoTr Km</div></div>
        <div class="stat-card"><div class="stat-number">80+</div><div class="stat-label" data-i18n="stat.discord">Discord Members</div></div>
      </div>
    </div>
  </section>

  <section class="section section--light" style="padding-top:1.5rem;padding-bottom:3rem;">
    <div class="container">
      <h2 class="section-title" data-i18n="about.title" style="margin:0 0 1.2rem 0;">About Us</h2>
      <div class="features-grid" style="margin-top:0;">
        <div class="feature-card"><div class="feature-icon">🔓</div><h3 class="feature-title" data-i18n="features.f1.title">Accessibility</h3><p class="feature-text" data-i18n="features.f1.text">We do not require a monthly mileage limit, mandatory participation in convoys, a specific age, in-game hours, DLCs, or a trial period.</p></div>
        <div class="feature-card"><div class="feature-icon">👤</div><h3 class="feature-title" data-i18n="features.f2.title">Identity</h3><p class="feature-text" data-i18n="features.f2.text">Recognizable branding including tractors, trailers, bus, avatar and tag.</p></div>
        <div class="feature-card"><div class="feature-icon">🪜</div><h3 class="feature-title" data-i18n="features.f3.title">Hierarchy</h3><p class="feature-text" data-i18n="features.f3.text">Our reputation system rewards the more active members of the company by giving their opinions greater weight in decision-making.</p></div>
        <div class="feature-card"><div class="feature-icon">👑</div><h3 class="feature-title" data-i18n="features.f4.title">Prestige</h3><p class="feature-text" data-i18n="features.f4.text">Own Website, Twitch Team and Merch - features that only a small fraction of the largest communities can boast.</p></div>
      </div>
    </div>
  </section>

</Base>

<script>
  import { TextEffect } from '../scripts/text-effect.js';
  const startTextEffect = () => {
    const title = document.querySelector('.hero-title[data-text-effect="per-word"]');
    if (title) TextEffect(title, { per: 'word', preset: 'blur' });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', startTextEffect, { once: true });
  else startTextEffect();
</script>
