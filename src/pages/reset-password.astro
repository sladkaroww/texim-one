---
import Base from '../layouts/Base.astro';
---
<Base title="Set New Password | TEXIM ONE" description="Set a new TEXIM ONE account password." path="/reset-password.html">
  <section class="account-page"><div class="container"><div class="account-card account-card--narrow">
    <h1 class="account-title">Set New Password</h1><p class="account-muted">Choose a new password for your TEXIM ONE account.</p>
    <form id="resetForm" class="account-form">
      <label>New password<input name="password" type="password" minlength="8" autocomplete="new-password" required /></label>
      <button class="btn btn-primary" type="submit">Update Password</button>
      <div id="accountMessage" class="account-message" role="status"></div>
    </form>
  </div></div></section>
  <script slot="scripts" src="/js/account.js" type="module"></script>
</Base>
