---
import Base from '../layouts/Base.astro';
---
<Base title="Reset Password | TEXIM ONE" description="Request a TEXIM ONE password reset link." path="/forgot-password.html">
  <section class="account-page"><div class="container"><div class="account-card account-card--narrow">
    <h1 class="account-title">Reset Password</h1><p class="account-muted">Enter your account email and we’ll send you a reset link.</p>
    <form id="forgotForm" class="account-form">
      <label>Email<input name="email" type="email" autocomplete="email" required /></label>
      <button class="btn btn-primary" type="submit">Send Reset Link</button>
      <div id="accountMessage" class="account-message" role="status"></div>
    </form>
    <p><a class="account-link" href="/login.html">Back to login</a></p>
  </div></div></section>
  <script slot="scripts" src="/js/account.js" type="module"></script>
</Base>
