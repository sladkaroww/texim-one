---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangModal from '../components/LangModal.astro';
import Preloader from '../components/Preloader.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  active?: string;
  path?: string;
  image?: string;
  robots?: string;
}

const {
  title,
  description = '',
  active = '',
  path = '/',
  image = '/img/og/og-image.jpg',
  robots = 'index,follow',
} = Astro.props;

const SITE = 'https://vtc.texim.one';
const canonical = new URL(path, SITE).href;
const ogImage = image.startsWith('http') ? image : new URL(image, SITE).href;
const analyticsToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN ?? 'c6129cb1f4ec4fa390f043ffbeb29066';

// Supabase publishable keys are safe to expose to the browser; RLS is the security boundary.
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? import.meta.env.SUPABASE_URL ?? 'https://raqvhwktxzsgeeyshijp.supabase.co';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? import.meta.env.SUPABASE_KEY ?? 'sb_publishable_9CK9hAhnEowjkvCH4ZHOlw_OcC5hoUB';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="TEXIM ONE" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1920" />
  <meta property="og:image:height" content="1080" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="bg_BG" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://i.ibb.co" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Orbitron:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/mobile.css" />
  <link rel="stylesheet" href="/css/account.css" />
  <link rel="icon" href="https://i.ibb.co/21RJ4r30/TEXIM-ONE-TRUE-CUT.png" type="image/png" />
  <style is:global>
    .texim-team-section { padding: 4rem 0; background: #ffffff; }
    .texim-team-header { text-align: center; margin-bottom: 2.5rem; }
    .texim-team-title { font-family: Orbitron, Inter, sans-serif; font-size: 2.2rem; font-weight: 700; color: #111111; margin: 0 0 .7rem; }
    .texim-team-subtitle { margin: 0; color: #666666; font-size: 1rem; }
    .texim-team-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
    
    /* Light панел стил */
    .texim-team-card { 
      display: flex; 
      flex-direction: column; 
      align-items: center; 
      text-align: center; 
      padding: 1.5rem 1.1rem; 
      background: #ffffff; 
      border: 1px solid #e5e7eb; 
      border-radius: 16px; 
      box-shadow: 0 8px 24px rgba(0,0,0,.06); 
      transition: transform .2s ease, box-shadow .2s ease; 
    }
    .texim-team-card:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(0,0,0,.1); }
    .texim-team-avatar { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; background: #f1f1f1; border: 2px solid #eeeeee; margin-bottom: 1rem; }
    .texim-team-name { font-family: Orbitron, Inter, sans-serif; font-size: .95rem; font-weight: 700; color: #111111; text-decoration: none; word-break: break-word; }
    .texim-team-name:hover { text-decoration: underline; }
    .texim-team-role { margin: .45rem 0 .8rem; color: #777777; font-size: .82rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
    
    /* Стилизация на новите графи Rank и Level */
    .texim-team-stats { display: flex; gap: .5rem; width: 100%; justify-content: center; margin-bottom: .8rem; }
    .texim-stat-box { 
      flex: 1; 
      background: #f8fafc; 
      border: 1px solid #e2e8f0; 
      border-radius: 8px; 
      padding: .4rem .2rem; 
      display: flex; 
      flex-direction: column; 
      align-items: center; 
    }
    .texim-stat-label { font-size: .65rem; color: #64748b; text-transform: uppercase; font-weight: 600; margin-bottom: 2px; }
    .texim-stat-val { font-family: Orbitron, sans-serif; font-size: .85rem; font-weight: 700; color: #0f172a; }
    
    .texim-team-link { font-size: .75rem; color: #555555; text-decoration: underline; font-weight: 500; }
    
    @media(max-width:1000px){ .texim-team-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media(max-width:700px){ 
      .texim-team-section { padding: 3rem 0; }
      .texim-team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem; }
      .texim-team-card { padding: 1.2rem .8rem; }
      .texim-team-avatar { width: 72px; height: 72px; }
    }
    @media(max-width:480px){ 
      .texim-team-grid { grid-template-columns: 1fr; }
      .texim-team-card { max-width: 340px; width: 100%; margin: 0 auto; }
    }
  </style>
  <slot name="head" />
</head>
<body>
  <script is:inline define:vars={{ supabaseUrl, supabaseKey }}>
    window.__TEXIM_SUPABASE__ = { url: supabaseUrl, key: supabaseKey };
  </script>
  <Preloader />
  <slot name="header"><Header active={active} /></slot>
  <main>
    <slot />
  </main>
  <Footer />
  <LangModal />
  <script src="/js/i18n.js" is:inline></script>
  <script src="/js/main.js" is:inline></script>
  <script src="/js/auth-ui.js" type="module"></script>
  <script is:inline>
    (() => {
      if (window.location.pathname !== '/' && window.location.pathname !== '/index.html') return;

      const mountTeam = () => {
        if (document.querySelector('.texim-team-section')) return;
        const aboutTitle = document.querySelector('h2[data-i18n="about.title"]');
        const aboutSection = aboutTitle?.closest('section');
        if (!aboutSection) return;

        // Масив със служителите, включващ новите полета rank и level
        const members = [
          { name: 'chea7er044', role: 'Owner', rank: '#1', level: '100', avatar: 'https://static.truckersmp.com/avatarsN/4710545.1766443403.png', profile: 'https://truckersmp.com/user/5605295' },
          { name: '[BG] Mitaka', role: 'Driver', rank: '#2', level: '45', avatar: 'https://static.truckersmp.com/avatarsN/4710545.1766443403.png', profile: 'https://truckersmp.com/user/4710545' },
          { name: '[BG] NiksaN', role: 'Driver', rank: '#3', level: '38', avatar: 'https://static.truckersmp.com/avatarsN/4492540.1766442611.png', profile: 'https://truckersmp.com/user/4492540' },
          { name: '[BG] Mariyanko', role: 'Driver', rank: '#4', level: '50', avatar: 'https://static.truckersmp.com/avatarsN/2587553.1767200331.png', profile: 'https://truckersmp.com/user/2587553' },
          { name: '[BG] Iv4o_56', role: 'Driver', rank: '#5', level: '29', avatar: 'https://static.truckersmp.com/avatarsN/4947166.1767264328.png', profile: 'https://truckersmp.com/user/4947166' },
          { name: 'SkodaSolaris', role: 'Driver', rank: '#6', level: '42', avatar: 'https://static.truckersmp.com/avatarsN/1910186.1767387345.png', profile: 'https://truckersmp.com/user/1910186' },
          { name: '[BG] cickaa', role: 'Driver', rank: '#7', level: '31', avatar: 'https://static.truckersmp.com/avatarsN/3597382.1767699185.png', profile: 'https://truckersmp.com/user/3597382' },
          { name: '[BG] Metko', role: 'Driver', rank: '#8', level: '22', avatar: 'https://static.truckersmp.com/avatarsN/5118236.1776869300.png', profile: 'https://truckersmp.com/user/5118236' },
          { name: 'AcerBG', role: 'Driver', rank: '#9', level: '18', avatar: 'https://static.truckersmp.com/avatarsN/2003826.1779619724.png', profile: 'https://truckersmp.com/user/2003826' },
          { name: 'Petkovv', role: 'Driver', rank: '#10', level: '15', avatar: 'https://static.truckersmp.com/avatarsN/6358471.1788385527.png', profile: 'https://truckersmp.com/user/6358471' },
          { name: 'hollowaznai', role: 'Driver', rank: '#11', level: '12', avatar: 'https://static.truckersmp.com/avatarsN/6358812.1788445624.png', profile: 'https://truckersmp.com/user/6358812' },
          { name: '[BG] slad', role: 'Representative', rank: '#12', level: '60', avatar: 'https://static.truckersmp.com/avatarsN/4049929.1766433092.png', profile: 'https://truckersmp.com/user/4049929' },
          { name: '[BG] Marvinito', role: 'Manager', rank: '#13', level: '85', avatar: 'https://static.truckersmp.com/avatarsN/2064608.1766412005.png', profile: 'https://truckersmp.com/user/2064608' }
        ];

        const section = document.createElement('section');
        section.className = 'texim-team-section';
        section.innerHTML = `
          <div class="container">
            <div class="texim-team-header">
              <h2 class="texim-team-title">Employees</h2>
            </div>
            <div class="texim-team-grid">
              ${members.map(member => `
                <article class="texim-team-card">
                  <img class="texim-team-avatar" src="${member.avatar}" alt="${member.name}" loading="lazy">
                  <a class="texim-team-name" href="${member.profile}" target="_blank" rel="noopener noreferrer">${member.name}</a>
                  <div class="texim-team-role">${member.role}</div>
                  
                  <!-- Новите графи Rank и Level -->
                  <div class="texim-team-stats">
                    <div class="texim-stat-box">
                      <span class="texim-stat-label">Rank</span>
                      <span class="texim-stat-val">${member.rank || '-'}</span>
                    </div>
                    <div class="texim-stat-box">
                      <span class="texim-stat-label">Level</span>
                      <span class="texim-stat-val">${member.level || '-'}</span>
                    </div>
                  </div>

                  <a class="texim-team-link" href="${member.profile}" target="_blank" rel="noopener noreferrer">TruckersMP</a>
                </article>
              `).join('')}
            </div>
          </div>`;

        aboutSection.insertAdjacentElement('afterend', section);
      };

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mountTeam, { once: true });
      else mountTeam();
    })();
  </script>
  <slot name="scripts" />
  <CookieConsent token={analyticsToken} />
</body>
</html>
