  }
</style>

  <style is:global>
    .section { padding: 3rem 0; box-sizing: border-box; }
    .section--white { background-color: #ffffff; }
    .section--light { background-color: #f8f9fa; }
    .text-center, .section-title, .section-subtitle, .section-bottom-subtitle {
      text-align: center !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }
    .section-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 2rem;
      font-weight: 700;
      color: #111111;
      margin-top: 0;
      margin-bottom: 0.5rem;
      line-height: 1.2;
    }
    .section-subtitle {
      color: #111111;
      font-size: 1.05rem;
      margin-top: 0;
      margin-bottom: 2rem;
      font-weight: 500;
      line-height: 1.5;
      max-width: 800px;
    }
    .section--white .section-subtitle { margin-bottom: 0; }
    .section-bottom-subtitle {
      color: #666666;
      font-size: 0.9rem;
      margin-top: 2rem;
      margin-bottom: 0;
      font-weight: 500;
      max-width: 900px;
    }
    .section-subtitle .subtitle-link {
      color: #0056b3 !important;
      font-weight: 600;
      text-decoration: underline !important;
      cursor: pointer;
      position: relative;
      z-index: 10;
      transition: color 0.2s ease;
    }
    .section-subtitle .subtitle-link:hover { color: #003d80 !important; }
    .fleet-grid-5 {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
      max-width: 1200px;
      margin: 0 auto;
    }
    .fleet-card-item {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 1.25rem;
      width: calc(33.333% - 1rem);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
      display: flex;
      flex-direction: column;
      text-align: left;
      box-sizing: border-box;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .fleet-card-item:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    }
    .fleet-img-wrap {
      width: 100%;
      height: 140px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
    }
    .fleet-img-wrap img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.08));
    }
    .fleet-card-content {
      border-top: 1px solid #f0f0f0;
      padding-top: 0.85rem;
    }
    .fleet-type-badge {
      font-family: 'Orbitron', sans-serif;
      font-size: 0.8rem;
      font-weight: 700;
      color: #111111;
      background: #f8f9fa;
      padding: 0.25rem 0.6rem;
      border-radius: 4px;
      display: inline-block;
      margin-bottom: 0.75rem;
      border: 1px solid #e2e8f0;
    }
    .fleet-info-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.9rem;
      margin-bottom: 0.35rem;
    }
    .fleet-label { color: #666666; font-weight: 500; }
    .fleet-value { color: #111111; font-weight: 600; }
    @media (max-width: 992px) { .fleet-card-item { width: calc(50% - 1rem); } }
    @media (max-width: 768px) {
      .section { padding: 2rem 0; }
      .section-title { font-size: 1.6rem; }
      .section-subtitle { font-size: 0.95rem; margin-bottom: 1.5rem; }
      .section-bottom-subtitle { margin-top: 1.5rem; }
    }
    @media (max-width: 600px) { .fleet-card-item { width: 100%; } }
  </style>
</Base>
