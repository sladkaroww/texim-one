---
import Base from '../layouts/Base.astro';
---
<Base title="Logout | TEXIM ONE" description="Sign out of your TEXIM ONE account." path="/logout.html">
  <section class="account-page"><div class="container"><div class="account-card account-card--narrow" style="text-align:center">
    <h1 class="account-title">Signing out…</h1><p id="accountMessage" class="account-message">Please wait.</p>
    <button id="logoutButton" class="btn btn-primary" type="button">Log out</button>
  </div></div></section>
  <script slot="scripts" src="/js/account.js" type="module"></script>
</Base>
