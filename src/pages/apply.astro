---
import Base from '../layouts/Base.astro';
---
<Base title="Join TEXIM ONE | Apply" description="Apply to become a TEXIM ONE member." active="apply" path="/apply.html">
  <section class="hero hero--inner"><div class="hero-bg" style="background-image:url('https://i.ibb.co/YFymQ1vB/ets2-20250308-221702-00.png');"></div><div class="hero-overlay"></div><div class="container"><div class="hero-content"><h1 class="hero-title">Apply</h1><p class="hero-subtitle">Fill out the form.</p></div></div></section>
  <section class="section section--light" style="padding-top: 2rem; padding-bottom: 2rem;">
    <div class="container section--narrow" style="max-width: 850px; margin: 0 auto; padding: 0;">
      <div class="invite-head" style="text-align: center; margin-top: 0; margin-bottom: 1.5rem;">
        <h2 class="section-title" style="margin: 0;">Google Form</h2>
      </div>
      <div style="width: 100%; overflow: hidden; border-radius: 8px;">
        <iframe
          src="https://docs.google.com/forms/d/e/1FAIpQLSeyx-HbluqrkCGu2glXe6W-r3Zr8519cuP3tPalZvu-k9HnXA/viewform?embedded=true"
          width="100%"
          height="900"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          style="display: block; width: 100%; border: 0; border-radius: 8px;"
          title="TEXIM ONE Application Form"
        >
          Зарежда се…
        </iframe>
      </div>
    </div>
  </section>
</Base>
