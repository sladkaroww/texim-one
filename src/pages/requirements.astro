---
import Base from '../layouts/Base.astro';

const title = 'Requirements & Fleet | TEXIM ONE';
const description = 'What it takes to drive for TEXIM ONE — age and Discord rules, available ranks, and our official truck fleet and skins.';
---
<Base title={title} description={description} active="requirements" path="/requirements.html">
  <section class="hero hero--inner">
    <div class="hero-bg" style="background-image:url('https://i.ibb.co/9mHLkpnw/ets2-20250308-220747-00.png');"></div>
    <div class="hero-overlay"></div>
    <div class="container"><div class="hero-content">
      <h1 class="hero-title" data-i18n="nav.events">Requirements</h1>
      <p class="hero-subtitle" data-i18n="events.sub">Corporate Identity.</p>
    </div></div>
  </section>

  <section class="section section--white">
    <div class="container text-center">
      <h2 class="section-title">Avatar & Tag</h2>
      <p class="section-subtitle">
        The <a href="https://i.ibb.co/ynhkwJh9/TEXIM1-AVATAR2026.png" target="_blank" rel="noopener noreferrer" class="subtitle-link">AVATAR</a> is used in TruckersMP and TrucksBook, while the <a href="https://i.ibb.co/MxSSQh3T/ets2-20260907-101253-00.png" target="_blank" rel="noopener noreferrer" class="subtitle-link">TAG</a> is used only in TruckersMP.
      </p>
    </div>
  </section>

  <section class="section section--light">
    <div class="container text-center">
      <h2 class="section-title">Vehicle Fleet</h2>
      <p class="section-subtitle">Required for formal events.</p>

      <div class="fleet-grid-5">
        <div class="fleet-card-item">
          <div class="fleet-img-wrap">
            <img src="https://i.ibb.co/NngmPy7D/ets2-20260907-093518-00-Photoroom.png" alt="Truck 1" loading="lazy" decoding="async" />
          </div>
          <div class="fleet-card-content">
            <span class="fleet-type-badge">Truck</span>
            <div class="fleet-info-row"><span class="fleet-label">Series:</span><span class="fleet-value">Volvo FH6 Aero Globetrotter XL</span></div>
            <div class="fleet-info-row"><span class="fleet-label">Paint Job:</span><span class="fleet-value">Vision</span></div>
          </div>
        </div>

        <div class="fleet-card-item">
          <div class="fleet-img-wrap">
            <img src="https://i.ibb.co/gb0ttC02/ets2-20260907-093526-00-Photoroom.png" alt="Trailer 1" loading="lazy" decoding="async" />
          </div>
          <div class="fleet-card-content">
            <span class="fleet-type-badge">Trailer</span>
            <div class="fleet-info-row"><span class="fleet-label">Series:</span><span class="fleet-value">Kässbohrer K.SCS X+</span></div>
            <div class="fleet-info-row"><span class="fleet-label">Paint Job:</span><span class="fleet-value">Kässbohrer White Arrow</span></div>
          </div>
        </div>

        <div class="fleet-card-item">
          <div class="fleet-img-wrap">
            <img src="COMING SOON" alt="Bus" loading="lazy" decoding="async" />
          </div>
          <div class="fleet-card-content">
            <span class="fleet-type-badge">Bus</span>
            <div class="fleet-info-row"><span class="fleet-label">Series:</span><span class="fleet-value">Volvo 9700 DD</span></div>
            <div class="fleet-info-row"><span class="fleet-label">Paint Job:</span><span class="fleet-value">Coming Soon</span></div>
          </div>
        </div>

        <div class="fleet-card-item">
          <div class="fleet-img-wrap">
            <img src="https://i.ibb.co/4wBKrzgz/ats-20260907-093747-00-Photoroom.png" alt="Truck 2" loading="lazy" decoding="async" />
          </div>
          <div class="fleet-card-content">
            <span class="fleet-type-badge">Truck</span>
            <div class="fleet-info-row"><span class="fleet-label">Series:</span><span class="fleet-value">Volvo VNL 860</span></div>
            <div class="fleet-info-row"><span class="fleet-label">Paint Job:</span><span class="fleet-value">Slipstream</span></div>
          </div>
        </div>

        <div class="fleet-card-item">
          <div class="fleet-img-wrap">
            <img src="https://i.ibb.co/j9XXNW24/ats-20260907-093740-00-Photoroom.png" alt="Trailer 2" loading="lazy" decoding="async" />
          </div>
          <div class="fleet-card-content">
            <span class="fleet-type-badge">Trailer</span>
            <div class="fleet-info-row"><span class="fleet-label">Series:</span><span class="fleet-value">Sliding Tarp</span></div>
            <div class="fleet-info-row"><span class="fleet-label">Paint Job:</span><span class="fleet-value">Aurora</span></div>
          </div>
        </div>
      </div>

      <p class="section-bottom-subtitle">HEX Colors: FFFFFF; 00000; E1E1E1; FF0000. Do not make any changes to the exterior, except for the paint.</p>
    </div>
  </section>

  <style is:global>
    .section { padding: 3rem 0; box-sizing: border-box; }
    .section--white { background-color: #ffffff; }
    .section--light { background-color: #f8f9fa; }
    .text-center, .section-title, .section-subtitle, .section-bottom-subtitle {
      text-align: center !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }
    .section-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 2rem;
      font-weight: 700;
      color: #111111;
      margin-top: 0;
      margin-bottom: 0.5rem;
      line-height: 1.2;
    }
    .section-subtitle {
      color: #111111;
      font-size: 1.05rem;
      margin-top: 0;
      margin-bottom: 2rem;
      font-weight: 500;
      line-height: 1.5;
      max-width: 800px;
    }
    .section--white .section-subtitle { margin-bottom: 0; }
    .section-bottom-subtitle {
      color: #666666;
      font-size: 0.9rem;
      margin-top: 2rem;
      margin-bottom: 0;
      font-weight: 500;
      max-width: 900px;
    }
    .section-subtitle .subtitle-link {
      color: #0056b3 !important;
      font-weight: 600;
      text-decoration: underline !important;
      cursor: pointer;
      position: relative;
      z-index: 10;
      transition: color 0.2s ease;
    }
    .section-subtitle .subtitle-link:hover { color: #003d80 !important; }
    .fleet-grid-5 {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
      max-width: 1200px;
      margin: 0 auto;
    }
    .fleet-card-item {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 1.25rem;
      width: calc(33.333% - 1rem);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
      display: flex;
      flex-direction: column;
      text-align: left;
      box-sizing: border-box;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .fleet-card-item:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    }
    .fleet-img-wrap {
      width: 100%;
      height: 140px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
    }
    .fleet-img-wrap img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.08));
    }
    .fleet-card-content {
      border-top: 1px solid #f0f0f0;
      padding-top: 0.85rem;
    }
    .fleet-type-badge {
      font-family: 'Orbitron', sans-serif;
      font-size: 0.8rem;
      font-weight: 700;
      color: #111111;
      background: #f8f9fa;
      padding: 0.25rem 0.6rem;
      border-radius: 4px;
      display: inline-block;
      margin-bottom: 0.75rem;
      border: 1px solid #e2e8f0;
    }
    .fleet-info-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.9rem;
      margin-bottom: 0.35rem;
    }
    .fleet-label { color: #666666; font-weight: 500; }
    .fleet-value { color: #111111; font-weight: 600; }
    @media (max-width: 992px) { .fleet-card-item { width: calc(50% - 1rem); } }
    @media (max-width: 768px) {
      .section { padding: 2rem 0; }
      .section-title { font-size: 1.6rem; }
      .section-subtitle { font-size: 0.95rem; margin-bottom: 1.5rem; }
      .section-bottom-subtitle { margin-top: 1.5rem; }
    }
    @media (max-width: 600px) { .fleet-card-item { width: 100%; } }
  </style>
</Base>
