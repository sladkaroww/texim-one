---
import Base from '../layouts/Base.astro';

const title = 'Partners & Merch | TEXIM ONE';
const description = 'TEXIM ONE partners, official merchandise, and community collaborations across TruckersMP and the ETS2 scene.';
---
<Base title={title} description={description} active="partners" path="/partners.html">
  <section class="hero hero--inner">
    <div class="hero-bg" style="background-image:url('https://i.ibb.co/Z6bCf7qm/ets2-20250308-222100-00.png');"></div>
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title" data-i18n="nav.partners">Partners</h1>
        <p class="hero-subtitle" data-i18n="partners.sub">Connected to the community.</p>
      </div>
    </div>
  </section>

  <!-- Блок 1: Merch (Снимка вляво, Текст вдясно) -->
  <section class="section custom-partners-section" style="background-color: #ffffff;">
    <div class="container">
      <div class="section-title-wrapper">
        <h2 class="section-title">
          Merch
        </h2>
      </div>

      <div class="hero-row" style="display: flex; align-items: center; gap: 3rem;">
        <div class="hero-truck" style="flex: 1;">
          <img src="https://i.ibb.co/Z6ZXTfnb/viber-image-2026-07-03-21-54-40-065.jpg" alt="TEXIM ONE Merch" style="width: 100%; height: auto; object-fit: contain; display: block;" />
        </div>

        <div class="hero-content" style="flex: 1;">
          <h3 style="font-size: 1.4rem; font-weight: 600; color: #111111; margin-bottom: 1rem;">
            🔥TEXIM ONE Ltd.🔥
          </h3>

          <p class="hero-text" style="color: #222222; line-height: 1.65; font-size: 1.3rem; margin-bottom: 1.8rem; font-weight: 400;">
            Heavyweight Oversized T-Shirts, Sweatshirts, and Hoodies made from 100% combed cotton. A minimalist design with precise embroidery, created for anyone who values quality and comfort.
          </p>

          <div class="hero-btns">
            <a href="http://texim.one/" class="btn btn-primary" target="_blank" rel="noopener">texim.one</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Блок 2: НОВ БЛОК (Текст вляво, Снимка вдясно) -->
  <section class="section custom-partners-section" style="background-color: #ffffff;">
    <div class="container">
      <div class="section-title-wrapper">
        <h2 class="section-title">
          IT Store
        </h2>
      </div>

      <div class="hero-row" style="display: flex; align-items: center; gap: 3rem;">
        <!-- Подзаглавие, описание и бутон ВЛЯВО -->
        <div class="hero-content" style="flex: 1; text-align: left;">
          <h3 style="font-size: 1.4rem; font-weight: 600; color: #111111; margin-bottom: 1rem;">
            🔥PIC Computer🔥
          </h3>

          <p class="hero-text" style="color: #222222; line-height: 1.65; font-size: 1.3rem; margin-bottom: 1.8rem; font-weight: 400;">
            Може да подкрепите общността, като пазарувате от PIC Computer чрез нашия афилиейт линк! Преди да направите поръчката си, трябва да влезете в сайта, като цъкнете бутона.
          </p>

          <div class="hero-btns" style="display: flex; justify-content: flex-start;">
            <a href="#" class="btn btn-primary" target="_blank" rel="https://www.pic.bg?affId=tex1m">pic.bg</a>
          </div>
        </div>

        <!-- Снимка ВДЯСНО -->
        <div class="hero-truck" style="flex: 1;">
          <img src="https://i.ibb.co/RV3Rh0S/565170148-1263470885819722-6077325697252228820-n.jpg" alt="Име на новия елемент" style="width: 100%; height: auto; object-fit: contain; display: block;" />
        </div>
      </div>
    </div>
  </section>

  <!-- Блок 3: Statistics (Текст вляво, Снимка вдясно) -->
  <section class="section custom-partners-section" style="background-color: #ffffff;">
    <div class="container">
      <div class="section-title-wrapper">
        <h2 class="section-title">
          Statistics
        </h2>
      </div>

      <div class="hero-row" style="display: flex; align-items: center; gap: 3rem;">
        <!-- Текст, подзаглавие и бутон ВЛЯВО -->
        <div class="hero-content" style="flex: 1; text-align: left;">
          <h3 style="font-size: 1.4rem; font-weight: 600; color: #111111; margin-bottom: 1rem;">
            🔥TrucksBook Bulgaria🔥
          </h3>

          <p class="hero-text" style="color: #222222; line-height: 1.65; font-size: 1.3rem; margin-bottom: 1.8rem; font-weight: 400;">
            TrucksBook Bulgaria is a Facebook page dedicated to statistics, from which we received a certificate recognizing our contribution to the community. We would like to express our gratitude and will continue to follow the development of the Bulgarian TrucksBook community.
          </p>

          <div class="hero-btns" style="display: flex; justify-content: flex-start;">
            <a href="https://www.facebook.com/trucksbook.bulgaria" class="btn btn-primary" target="_blank" rel="noopener">Facebook</a>
          </div>
        </div>

        <!-- Изображение ВДЯСНО -->
        <div class="hero-truck" style="flex: 1;">
          <img src="https://i.ibb.co/G3FMtvmR/CERTIFICATE-ALL-TIME.png" alt="TrucksBook Bulgaria Certificate" style="width: 100%; height: auto; object-fit: contain; display: block;" />
        </div>
      </div>
    </div>
  </section>

  <!-- Блок 4: Collaboration -->
  <section class="section section--light custom-partners-section">
    <div class="container">
      <div class="section-title-wrapper">
        <h2 class="section-title">Collaboration</h2>
      </div>
      <div class="partners-content">
        <p class="section-text text-center partners-text">
          If you would like to collaborate on joining our Twitch Team, creating your future Merch, or for any other reason, you can contact us via our Discord Server.
        </p>
      </div>
    </div>
  </section>

  <style is:global>
    /* Уеднаквяване на отстоянията над и под всяка секция */
    .custom-partners-section {
      padding-top: 1.5rem !important;
      padding-bottom: 1.5rem !important;
    }

    /* Уеднаквяване на центрирането и разстоянието под заглавията */
    .section-title-wrapper {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .section-title-wrapper .section-title,
    .custom-partners-section .section-title {
      margin: 0 0 1.5rem 0 !important;
    }

    .partners-content { 
      max-width: 800px; 
      margin: 0 auto; 
    }

    .partners-text { 
      margin-bottom: 0; 
    }

    .text-center { 
      text-align: center; 
    }
  </style>
</Base>
