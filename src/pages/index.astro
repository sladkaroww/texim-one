---
import Base from '../layouts/Base.astro';

const title = 'TEXIM ONE';
const description = 'TEXIM ONE - Bulgarian virtual trucking company. Convoys, community and innovation in TruckersMP.';
---
<Base title={title} description={description} active="home">
  <link rel="stylesheet" href="/css/mobile.css" slot="head" />
  <section class="hero hero-with-truck">
    <div class="hero-bg" style="background-image:url('https://files.catbox.moe/g9j45t.jpg');"></div>
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-row">
        <div class="hero-content" style="display:flex;flex-direction:column;gap:20px;">
          <h1 class="hero-title text-effect" data-text-effect="per-word" data-text-preset="blur" style="font-size:2.2rem;line-height:1.2;margin:0;">"Always 1 in mind, behind TEXIM!"</h1>
          <p class="hero-text" style="margin:0;line-height:1.5;"><a href="https://trucksbook.eu/company/218511" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;">TEXIM ONE</a> was launched on January 1, 2026, as a natural extension of <a href="https://trucksbook.eu/company/39218" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;">TEXIM</a>, which was founded on March 10, 2019.</p>
          <p class="hero-subtitle" style="margin:0;line-height:1.2;">VTC - Virtual Trucking Company</p>
          <div class="hero-btns" style="margin:0;padding:0;"><a href="https://discord.com/invite/2sSKVXUtn" class="btn btn-outline" data-i18n="hero.discord" target="_blank" rel="noopener">Discord Server</a></div>
        </div>
        <div class="hero-truck" aria-hidden="true"><img src="https://files.catbox.moe/kf8238.png" alt="TEXIM ONE Truck" class="hero-truck-img" /></div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:1.5rem;padding-bottom:1.5rem;">
    <div class="container">
      <h2 class="section-title" data-i18n="stats.title" style="margin:0 0 1.2rem 0;">Statistics</h2>
      <div class="stats-grid" style="margin-top:0;">
        <div class="stat-card"><div class="stat-number">10+</div><div class="stat-label" data-i18n="stat.drivers">Employees</div></div>
        <div class="stat-card"><div class="stat-number">7+</div><div class="stat-label" data-i18n="stat.founded">Years experience</div></div>
        <div class="stat-card"><div class="stat-number">9+</div><div class="stat-label" data-i18n="stat.km">Mln WoTr Km</div></div>
        <div class="stat-card"><div class="stat-number">80+</div><div class="stat-label" data-i18n="stat.discord">Discord Members</div></div>
      </div>
    </div>
  </section>

  <section class="section section--light" style="padding-top:1.5rem;padding-bottom:3rem;">
    <div class="container">
      <h2 class="section-title" data-i18n="about.title" style="margin:0 0 1.2rem 0;">About Us</h2>
      <div class="features-grid" style="margin-top:0;">
        <div class="feature-card"><div class="feature-icon">🔓</div><h3 class="feature-title" data-i18n="features.f1.title">Accessibility</h3><p class="feature-text" data-i18n="features.f1.text">We do not require a monthly mileage limit, mandatory participation in convoys, a specific age, in-game hours, DLCs, or a trial period.</p></div>
        <div class="feature-card"><div class="feature-icon">👤</div><h3 class="feature-title" data-i18n="features.f2.title">Identity</h3><p class="feature-text" data-i18n="features.f2.text">Recognizable branding including tractors, trailers, bus, avatar and tag.</p></div>
        <div class="feature-card"><div class="feature-icon">🪜</div><h3 class="feature-title" data-i18n="features.f3.title">Hierarchy</h3><p class="feature-text" data-i18n="features.f3.text">Our reputation system rewards the more active members of the company by giving their opinions greater weight in decision-making.</p></div>
        <div class="feature-card"><div class="feature-icon">👑</div><h3 class="feature-title" data-i18n="features.f4.title">Prestige</h3><p class="feature-text" data-i18n="features.f4.text">Own Website, Twitch Team and Merch - features that only a small fraction of the largest communities can boast.</p></div>
      </div>
    </div>
  </section>

</Base>

<script>
  import { TextEffect } from '../scripts/text-effect.js';
  const startTextEffect = () => {
    const title = document.querySelector('.hero-title[data-text-effect="per-word"]');
    if (title) TextEffect(title, { per: 'word', preset: 'blur' });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', startTextEffect, { once: true });
  else startTextEffect();
</script>
