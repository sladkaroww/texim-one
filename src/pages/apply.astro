---
import Base from '../layouts/Base.astro';

const title = 'Apply';
const description = 'We will contact you.';
---
<Base title={title} description={description} active="apply">
  <section class="hero hero--inner">
    <div class="hero-bg" style="background-image:url('https://i.ibb.co/YFymQ1vB/ets2-20250308-221702-00.png');"></div>
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title" data-i18n="nav.apply">Apply</h1>
        <p class="hero-subtitle" data-i18n="apply.sub">Fill out the form.</p>
      </div>
    </div>
  </section>

  <section class="section section--light" id="Google Form" style="padding-top: 2rem; padding-bottom: 2rem;">
    <div class="container section--narrow" style="max-width: 850px; margin: 0 auto; padding: 0;">
      <div class="invite-head" style="text-align: center; margin-top: 0; margin-bottom: 1rem;">
        <h2 class="section-title" data-i18n="apply.title" style="margin: 0;">Google Form</h2>
      </div>

      <iframe
        src="https://docs.google.com/forms/d/e/1FAIpQLSeyx-HbluqrkCGu2glXe6W-r3Zr8519cuP3tPalZvu-k9HnXA/viewform?embedded=true"
        width="100%"
        height="1140"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        style="width: 100%; height: 1140px; border: none; border-radius: 8px; display: block;">
        Зарежда се…
      </iframe>
    </div>
  </section>
</Base>
