---
import Base from '../layouts/Base.astro';
---
<Base title="Join TEXIM ONE | Apply" description="Apply to become a TEXIM ONE member." active="apply" path="/apply.html">
  <section class="hero hero--inner"><div class="hero-bg" style="background-image:url('https://i.ibb.co/YFymQ1vB/ets2-20250308-221702-00.png');"></div><div class="hero-overlay"></div><div class="container"><div class="hero-content"><h1 class="hero-title">Join TEXIM ONE</h1><p class="hero-subtitle">Apply to become a member of our VTC.</p></div></div></section>
  <section class="section section--light"><div class="container"><div class="account-card">
    <h2 class="account-title">Membership Application</h2><p class="account-muted">Tell us a little about yourself and your TruckersMP experience.</p>
    <form id="applicationForm" class="account-form">
      <label>TruckersMP username<input name="truckersmp_username" required maxlength="60" /></label>
      <label>Discord username<input name="discord_username" required maxlength="100" /></label>
      <label>Age<input name="age" type="number" min="13" max="100" required /></label>
      <label>TruckersMP / VTC experience<textarea name="experience" rows="4" required></textarea></label>
      <label>Why do you want to join TEXIM ONE?<textarea name="reason" rows="5" required></textarea></label>
      <button class="btn btn-primary" type="submit">Submit Application</button><div id="applicationStatus" class="account-message" role="status"></div>
    </form>
    <h2 style="margin-top:2.5rem">My Applications</h2><div id="myApplications" class="account-grid"><div class="empty-state">Loading…</div></div>
  </div></div></section>
  <script slot="scripts" src="/js/application.js" type="module"></script>
</Base>
