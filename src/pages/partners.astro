---
import Base from '../layouts/Base.astro';

const title = 'Partners';
const description = 'Connected to the community.';
---
<Base title={title} description={description} active="partners">
  <section class="hero hero--inner">
    <div class="hero-bg" style="background-image:url('https://i.ibb.co/Z6bCf7qm/ets2-20250308-222100-00.png');"></div>
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title" data-i18n="nav.partners">Partners</h1>
        <p class="hero-subtitle" data-i18n="partners.sub">Connected to the community.</p>
      </div>
    </div>
  </section>

  <section class="section" style="background-color: #ffffff; padding-top: 3rem; padding-bottom: 3rem;">
    <div class="container">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <h2 class="section-title" style="margin: 0;">
          Merch
        </h2>
      </div>

      <div class="hero-row" style="display: flex; align-items: center; gap: 3rem;">
        <div class="hero-truck" style="flex: 1;">
          <img src="https://i.ibb.co/Z6ZXTfnb/viber-image-2026-07-03-21-54-40-065.jpg" alt="TEXIM ONE Merch" style="width: 100%; height: auto; object-fit: contain; display: block;" />
        </div>

        <div class="hero-content" style="flex: 1;">
          <h3 style="font-size: 1.4rem; font-weight: 600; color: #111111; margin-bottom: 1rem;">
            🔥TEXIM ONE Vtc. x TEXIM ONE Ltd.🔥
          </h3>

          <p class="hero-text" style="color: #222222; line-height: 1.65; font-size: 1.3rem; margin-bottom: 1.8rem; font-weight: 400;">
            Heavyweight Oversized T-Shirts, Sweatshirts, and Hoodies made from 100% combed cotton. A minimalist design with precise embroidery, created for anyone who values quality and comfort.
          </p>

          <div class="hero-btns">
            <a href="http://texim.one/" class="btn btn-primary" target="_blank" rel="noopener">texim.one</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--light partners-section">
    <div class="container">
      <h2 class="section-title partners-title">Collaboration</h2>
      <div class="partners-content">
        <p class="section-text text-center partners-text">
          If you would like to collaborate on joining our Twitch Team, creating your future Merch, or for any other reason, you can contact us via our Discord Server.
        </p>
      </div>
    </div>
  </section>

  <style is:global>
    .partners-section { padding: 3rem 0; }
    .partners-title { margin-top: 0; margin-bottom: 1.5rem; }
    .partners-content { max-width: 800px; margin: 0 auto; }
    .partners-text { margin-bottom: 0; }
    .text-center { text-align: center; }
  </style>
</Base>
