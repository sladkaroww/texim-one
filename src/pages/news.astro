---
import Base from '../layouts/Base.astro';
---
<Base title="News | TEXIM ONE" description="Latest TEXIM ONE news and announcements." path="/news.html">
  <section class="hero hero--inner"><div class="hero-bg" style="background-image:url('https://i.ibb.co/4n4FZpq4/viber-2025-03-10-09-33-32-746.jpg');"></div><div class="hero-overlay"></div><div class="container"><div class="hero-content"><h1 class="hero-title">News</h1><p class="hero-subtitle">Latest news and announcements from TEXIM ONE.</p></div></div></section>
  <section class="section section--light"><div class="container"><div id="newsGrid" class="news-db-grid"><div class="empty-state">Loading news…</div></div><p id="newsStatus" class="account-muted"></p></div></section>
  <script slot="scripts" src="/js/news.js" type="module"></script>
</Base>
