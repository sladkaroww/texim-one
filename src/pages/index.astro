---
import Base from '../layouts/Base.astro';

const title = 'TEXIM ONE — Bulgarian VTC for TruckersMP';
const description = 'TEXIM ONE is a Bulgarian virtual trucking company in TruckersMP — weekly convoys, real-rules driving, and a tight community since 2019.';
---
<Base title={title} description={description} active="home" path="/">
  <section class="hero hero-with-truck">
    <div class="hero-bg" style="background-image:url('https://files.catbox.moe/g9j45t.jpg');"></div>
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-row">
        <div class="hero-content" style="display:flex;flex-direction:column;gap:20px;">
          <h1 class="hero-title text-effect" data-text-effect="per-word" data-text-preset="blur" style="font-size:2.2rem;line-height:1.2;margin:0;">"Always 1 in mind, behind TEXIM!"</h1>
          <p class="hero-text" style="margin:0;line-height:1.5;"><a href="https://trucksbook.eu/company/218511" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;">TEXIM ONE</a> was launched on January 1, 2026, as a natural extension of <a href="https://trucksbook.eu/company/39218" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;">TEXIM</a>, which was founded on March 10, 2019.</p>
          <p class="hero-subtitle" style="margin:0;line-height:1.2;">VTC - Virtual Trucking Company</p>
          <div class="hero-btns" style="margin:0;padding:0;">
            <a href="https://discord.com/invite/2sSKVXUtn" class="btn btn-outline" data-i18n="hero.discord" target="_blank" rel="noopener">Discord Server</a>
          </div>
        </div>
        <div class="hero-truck" aria-hidden="true"><img src="https://files.catbox.moe/kf8238.png" alt="TEXIM ONE Truck" class="hero-truck-img" /></div>
      </div>
    </div>
  </section>

<section class="fleet-carousel-section">
  <div class="container text-center">
    <h2 class="section-title">Vehicles</h2>

    <div class="carousel-3d-wrapper">
      
      <!-- Лява стрелка -->
      <button type="button" class="nav-arrow prev-arrow" id="prevBtn" aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <!-- 3D Сцена за картите -->
      <div class="carousel-3d-stage" id="carouselStage">
        
        <!-- 1. VOLVO FH6 -->
        <div class="fleet-card" data-index="0">
          <h3 class="truck-title">Volvo FH6</h3>
          <div class="truck-image-box">
            <img src="https://i.ibb.co/PvJDkJFR/Chat-GPT-Image-Sep-7-2026-10-23-47-PM.png" alt="Volvo FH6" />
          </div>
          <div class="truck-spec-badge">
            <div class="spec-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <span class="spec-hp-val">780 HP</span>
          </div>
        </div>

        <!-- 2. MAN TGX -->
        <div class="fleet-card" data-index="1">
          <h3 class="truck-title">MAN TGX</h3>
          <div class="truck-image-box">
            <img src="https://i.ibb.co/VcqfYwwF/Chat-GPT-Image-Sep-7-2026-10-22-27-PM.png" alt="MAN TGX" />
          </div>
          <div class="truck-spec-badge">
            <div class="spec-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <span class="spec-hp-val">640 HP</span>
          </div>
        </div>

        <!-- 3. MERCEDES NEW ACTROS -->
        <div class="fleet-card" data-index="2">
          <h3 class="truck-title">Mercedes New Actros</h3>
          <div class="truck-image-box">
            <img src="https://i.ibb.co/cXDy24yN/Chat-GPT-Image-Sep-7-2026-10-25-18-PM.png" alt="Mercedes New Actros" />
          </div>
          <div class="truck-spec-badge">
            <div class="spec-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <span class="spec-hp-val">625 HP</span>
          </div>
        </div>

        <!-- 4. SCANIA S -->
        <div class="fleet-card" data-index="3">
          <h3 class="truck-title">Scania S</h3>
          <div class="truck-image-box">
            <img src="https://i.ibb.co/2YMfJWfV/Chat-GPT-Image-Sep-7-2026-10-26-15-PM.png" alt="Scania S" />
          </div>
          <div class="truck-spec-badge">
            <div class="spec-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <span class="spec-hp-val">770 HP</span>
          </div>
        </div>

      </div>

      <!-- Дясна стрелка -->
      <button type="button" class="nav-arrow next-arrow" id="nextBtn" aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>

    </div>

    <!-- 4 Индикаторни точки -->
    <div class="carousel-pagination">
      <span class="dot active" data-dot="0"></span>
      <span class="dot" data-dot="1"></span>
      <span class="dot" data-dot="2"></span>
      <span class="dot" data-dot="3"></span>
    </div>

  </div>
</section>

<style>
  .fleet-carousel-section {
    padding: 60px 0;
    background-color: #ffffff;
    overflow: hidden;
  }

  .section-title {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 50px;
    color: #000000;
  }

  /* Външна 3D Сцена */
  .carousel-3d-wrapper {
    position: relative;
    width: 100%;
    max-width: 1280px;
    height: 480px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-3d-stage {
    position: relative;
    width: 100%;
    height: 100%;
    perspective: 1200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Дизайн на Картата */
  .fleet-card {
    position: absolute;
    width: 340px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 28px 22px 24px 22px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.6s ease, border-color 0.6s ease, box-shadow 0.6s ease;
    cursor: pointer;
    user-select: none;
    opacity: 0;
    pointer-events: none;
  }

  /* Позиция: ЦЕНТЪР (Много по-голям) */
  .fleet-card.card-center {
    opacity: 1;
    pointer-events: auto;
    z-index: 5;
    transform: translateX(0) scale(1.22) rotateY(0deg);
    border-color: #000000;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
  }

  /* Позиция: ЛЯВО (Обърнат надясно) */
  .fleet-card.card-left {
    opacity: 0.75;
    pointer-events: auto;
    z-index: 3;
    transform: translateX(-380px) scale(0.85) rotateY(18deg);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
  }

  /* Позиция: ДЯСНО (Обърнат наляво) */
  .fleet-card.card-right {
    opacity: 0.75;
    pointer-events: auto;
    z-index: 3;
    transform: translateX(380px) scale(0.85) rotateY(-18deg);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
  }

  /* Скрити карти */
  .fleet-card.card-hidden {
    opacity: 0;
    z-index: 1;
    transform: translateX(0) scale(0.5);
  }

  .truck-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #000000;
    margin: 0 0 16px 0;
    text-align: left;
  }

  .truck-image-box {
    width: 100%;
    height: 180px;
    background: #f4f4f6;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    margin-bottom: 20px;
    box-sizing: border-box;
  }

  .truck-image-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .truck-spec-badge {
    align-self: center;
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    padding: 8px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 85px;
  }

  .spec-icon {
    width: 26px;
    height: 26px;
    background: #000000;
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spec-hp-val {
    font-size: 0.85rem;
    font-weight: 700;
    color: #000000;
  }

  /* Навигационни стрелки - висока интерактивност */
  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 100; /* Намира се над всичко */
    pointer-events: auto;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .nav-arrow:hover {
    background: #000000;
    color: #ffffff;
    border-color: #000000;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }

  .prev-arrow { left: 15px; }
  .next-arrow { right: 15px; }

  /* Точки */
  .carousel-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 30px;
  }

  .dot {
    width: 10px;
    height: 10px;
    background-color: #e0e0e0;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dot.active {
    background-color: #000000;
    transform: scale(1.4);
  }

  /* Респонсив */
  @media (max-width: 900px) {
    .fleet-card.card-left {
      transform: translateX(-240px) scale(0.75) rotateY(20deg);
    }
    .fleet-card.card-right {
      transform: translateX(240px) scale(0.75) rotateY(-20deg);
    }
    .fleet-card.card-center {
      transform: translateX(0) scale(1.05) rotateY(0deg);
    }
  }

  @media (max-width: 650px) {
    .fleet-card.card-left,
    .fleet-card.card-right {
      opacity: 0;
      pointer-events: none;
    }
    .fleet-card.card-center {
      transform: translateX(0) scale(1) rotateY(0deg);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    let activeIndex = 0;
    const cards = document.querySelectorAll('.fleet-card');
    const dots = document.querySelectorAll('.dot');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const totalCards = cards.length;
    let autoTimer;

    function update3DCarousel() {
      cards.forEach((card, idx) => {
        card.classList.remove('card-center', 'card-left', 'card-right', 'card-hidden');

        let leftIndex = (activeIndex - 1 + totalCards) % totalCards;
        let rightIndex = (activeIndex + 1) % totalCards;

        if (idx === activeIndex) {
          card.classList.add('card-center');
        } else if (idx === leftIndex) {
          card.classList.add('card-left');
        } else if (idx === rightIndex) {
          card.classList.add('card-right');
        } else {
          card.classList.add('card-hidden');
        }
      });

      dots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === activeIndex);
      });
    }

    function goToCard(index) {
      activeIndex = index;
      update3DCarousel();
      resetTimer();
    }

    function nextSlide() {
      activeIndex = (activeIndex + 1) % totalCards;
      update3DCarousel();
      resetTimer();
    }

    function prevSlide() {
      activeIndex = (activeIndex - 1 + totalCards) % totalCards;
      update3DCarousel();
      resetTimer();
    }

    function resetTimer() {
      clearInterval(autoTimer);
      autoTimer = setInterval(nextSlide, 4000);
    }

    // Закачане на събития за стрелките
    if (prevBtn) prevBtn.addEventListener('click', prevSlide);
    if (nextBtn) nextBtn.addEventListener('click', nextSlide);

    // Закачане на събития за точките
    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => goToCard(idx));
    });

    // Закачане на клик върху самите карти
    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        if (idx !== activeIndex) {
          goToCard(idx);
        }
      });
    });

    // Стартиране
    update3DCarousel();
    resetTimer();
  });
</script>

  <section class="section" style="padding-top:1.5rem;padding-bottom:1.5rem;">
    <div class="container">
      <h2 class="section-title" data-i18n="stats.title" style="margin:0 0 1.2rem 0;">Statistics</h2>
      <div class="stats-grid" style="margin-top:0;">
        <div class="stat-card"><div class="stat-number">10+</div><div class="stat-label" data-i18n="stat.drivers">Employees</div></div>
        <div class="stat-card"><div class="stat-number">7+</div><div class="stat-label" data-i18n="stat.founded">Years experience</div></div>
        <div class="stat-card"><div class="stat-number">9+</div><div class="stat-label" data-i18n="stat.km">Mln WoTr Km</div></div>
        <div class="stat-card"><div class="stat-number">80+</div><div class="stat-label" data-i18n="stat.discord">Discord Members</div></div>
      </div>
    </div>
  </section>

  <section class="section section--light" style="padding-top:1.5rem;padding-bottom:3rem;">
    <div class="container">
      <h2 class="section-title" data-i18n="about.title" style="margin:0 0 1.2rem 0;">About Us</h2>
      <div class="features-grid" style="margin-top:0;">
        <div class="feature-card"><div class="feature-icon">🔓</div><h3 class="feature-title" data-i18n="features.f1.title">Accessibility</h3><p class="feature-text" data-i18n="features.f1.text">We do not require a monthly mileage limit, mandatory participation in convoys, a specific age, in-game hours, DLCs, or a trial period.</p></div>
        <div class="feature-card"><div class="feature-icon">👤</div><h3 class="feature-title" data-i18n="features.f2.title">Identity</h3><p class="feature-text" data-i18n="features.f2.text">Recognizable branding including tractors, trailers, bus, avatar and tag.</p></div>
        <div class="feature-card"><div class="feature-icon">🪜</div><h3 class="feature-title" data-i18n="features.f3.title">Hierarchy</h3><p class="feature-text" data-i18n="features.f3.text">Our reputation system rewards the more active members of the company by giving their opinions greater weight in decision-making.</p></div>
        <div class="feature-card"><div class="feature-icon">👑</div><h3 class="feature-title" data-i18n="features.f4.title">Prestige</h3><p class="feature-text" data-i18n="features.f4.text">Own Website, Twitch Team and Merch - features that only a small fraction of the largest communities can boast.</p></div>
      </div>
    </div>
  </section>

</Base>

<script>
  import { TextEffect } from '../scripts/text-effect.js';
  const startTextEffect = () => {
    const title = document.querySelector('.hero-title[data-text-effect="per-word"]');
    if (title) TextEffect(title, { per: 'word', preset: 'blur' });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', startTextEffect, { once: true });
  else startTextEffect();
</script>
