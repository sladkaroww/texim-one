---
---
<div id="langModal" class="lang-modal">
  <div class="lang-modal-box">
    <div class="lang-flags">🌐</div>
    <h2 class="lang-title" data-i18n="modal.title">Choose Language</h2>
    <p class="lang-sub" data-i18n="modal.sub">Select your preferred language</p>
    <div class="lang-options">
      <button class="lang-option" data-lang="en"><span class="lang-flag">🇬🇧</span><span>English</span></button>
      <button class="lang-option" data-lang="bg"><span class="lang-flag">🇧🇬</span><span>Български</span></button>
    </div>
    <button class="lang-close" aria-label="Close">✕</button>
  </div>
</div>
