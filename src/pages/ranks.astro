---
import Base from '../layouts/Base.astro';

const title = 'The Power of Authority | TEXIM ONE';
const description = 'Build your reputation, raise your standing, and set the direction for the community.';
---
<Base title={title} description={description} active="ranks" path="/ranks.html">
  <section class="hero hero--inner">
    <div class="hero-bg" style="background-image:url('https://i.ibb.co/CKpZkbnP/ets2-20250308-220351-00.png');"></div>
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title" data-i18n="nav.ranks">Ranks</h1>
        <p class="hero-subtitle" data-i18n="ranks.sub">The Power of Authority.</p>
      </div>
    </div>
  </section>

<section class="section section--white">
  <div class="container text-center">
    
    <!-- Разпънат контейнер за таблицата -->
    <div class="full-table-wrapper">
      <iframe 
        src="https://docs.google.com/spreadsheets/d/e/2PACX-1vSpsfoa5PWmppRtGeUQV_h0e4f2QpXFKDRRrHnl0yCBwrWCIIaQBo06YvNajSazidWlSxvOQ9Vj-ive/pubhtml?widget=false&amp;headers=false&amp;chrome=false" 
        scrolling="no">
      </iframe>
    </div>

  </div>
</section>

<style>
  .full-table-wrapper {
    width: 100%;
    max-width: 1200px; /* Разпъване по ширина */
    margin: 0 auto;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    background-color: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .full-table-wrapper iframe {
    width: 100%;
    /* Регулирайте тази височина според това колко реда имате в таблицата, за да се види цялата без скролбар */
    height: 1200px; 
    border: none;
    display: block;
    overflow: hidden;
  }
</style>
