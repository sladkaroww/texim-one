<style>
  /* Подравняване на заглавната кутия и значката */
  .fleet-card-header {
    display: flex !important;
    flex-direction: column !important;
    height: 165px !important;
    justify-content: space-between !important;
    align-items: flex-start !important;
    width: 100% !important;
    margin-bottom: 12px !important;
  }

  .fleet-img-wrap {
    height: 120px !important;
    width: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .fleet-img-wrap img {
    max-height: 100% !important;
    max-width: 100% !important;
    object-fit: contain !important;
  }

  .fleet-type-badge {
    align-self: flex-start !important;
    margin: 0 !important;
    background-color: #000000 !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    font-size: 0.75rem !important;
    padding: 3px 8px !important;
    border-radius: 4px !important;
  }

  /* Решетка с 3 кутийки */
  .specs-grid-3 {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 6px !important;
    width: 100% !important;
  }

  .spec-card {
    background: #f8f9fa !important;
    border: 1px solid #e5e5e5 !important;
    border-radius: 8px !important;
    padding: 8px 3px !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    justify-content: center !important;
  }

  .spec-icon {
    width: 28px !important;
    height: 28px !important;
    background: #000000 !important;
    color: #ffffff !important;
    border-radius: 6px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin-bottom: 6px !important;
  }

  .spec-value {
    font-size: 0.72rem !important;
    font-weight: 700 !important;
    color: #111111 !important;
    line-height: 1.1 !important;
    margin-bottom: 3px !important;
    word-break: break-word !important;
  }

  .spec-label {
    font-size: 0.55rem !important;
    font-weight: 600 !important;
    color: #777777 !important;
    letter-spacing: 0.3px !important;
    text-transform: uppercase !important;
  }
</style>

  <section class="section" style="padding-top:1.5rem;padding-bottom:1.5rem;">
    <div class="container">
      <h2 class="section-title" data-i18n="stats.title" style="margin:0 0 1.2rem 0;">Statistics</h2>
      <div class="stats-grid" style="margin-top:0;">
        <div class="stat-card"><div class="stat-number">10+</div><div class="stat-label" data-i18n="stat.drivers">Employees</div></div>
        <div class="stat-card"><div class="stat-number">7+</div><div class="stat-label" data-i18n="stat.founded">Years experience</div></div>
        <div class="stat-card"><div class="stat-number">9+</div><div class="stat-label" data-i18n="stat.km">Mln WoTr Km</div></div>
        <div class="stat-card"><div class="stat-number">80+</div><div class="stat-label" data-i18n="stat.discord">Discord Members</div></div>
      </div>
    </div>
  </section>

