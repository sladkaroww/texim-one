---
import Base from '../layouts/Base.astro';

const title = 'The Power of Authority | TEXIM ONE';
const description = 'Build your reputation, raise your standing, and set the direction for the community.';
---
<Base title={title} description={description} active="ranks" path="/ranks.html">
  <section class="hero hero--inner">
    <div class="hero-bg" style="background-image:url('https://i.ibb.co/CKpZkbnP/ets2-20250308-220351-00.png');"></div>
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title" data-i18n="nav.ranks">Ranks</h1>
        <p class="hero-subtitle" data-i18n="ranks.sub">The Power of Authority.</p>
      </div>
    </div>
  </section>

<section class="section section--white">
  <div class="container text-center">
    
    <!-- Контейнер за таблицата със светъл фон -->
    <div class="table-container">
      <iframe 
        src="https://docs.google.com/spreadsheets/d/e/2PACX-1vSpsfoa5PWmppRtGeUQV_h0e4f2QpXFKDRRrHnl0yCBwrWCIIaQBo06YvNajSazidWlSxvOQ9Vj-ive/pubhtml?widget=true&amp;headers=false&amp;chrome=false" 
        title="Google Sheet"
        loading="lazy">
      </iframe>
    </div>

  </div>
</section>

<style>
  /* Контейнер със светъл фон (Light) и заоблени ъгли */
  .table-container {
    width: 100%;
    max-width: 1100px;
    height: 600px; /* Височина на таблицата */
    margin: 20px auto;
    background-color: #f8f9fa; /* Light фон */
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  /* Вграден iframe */
  .table-container iframe {
    width: 100%;
    height: 100%;
    border: none;
    background-color: #ffffff; /* Светъл цвят за самата таблица */
    display: block;
  }

  /* Мобилна адаптация */
  @media (max-width: 768px) {
    .table-container {
      height: 450px;
      border-radius: 10px;
    }
  }
</style>
