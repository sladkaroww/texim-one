---
import Base from '../layouts/Base.astro';

const title = 'The Power of Authority | TEXIM ONE';
const description = 'Build your reputation, raise your standing, and set the direction for the community.';
---
<Base title={title} description={description} active="reputation" path="/reputation.html">
  <section class="hero hero--inner">
    <div class="hero-bg" style="background-image:url('https://i.ibb.co/CKpZkbnP/ets2-20250308-220351-00.png');"></div>
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title" data-i18n="nav.ranks">Reputation</h1>
        <p class="hero-subtitle" data-i18n="ranks.sub">The Power of Authority.</p>
      </div>
    </div>
  </section>

<section class="section section--white">
  <div class="container text-center">
    
    <!-- Блок 1: Reputation System (Снимка) -->
    <div class="reputation-block">
      <h2 class="section-title">Reputation System</h2>
      <div class="full-image-wrapper">
        <img 
          src="https://i.ibb.co/2708PT5b/Gemini-Generated-Image-r121lrr121lrr121.jpg" 
          alt="Reputation Points" 
          class="full-size-image"
        />
      </div>
    </div>

    <!-- Блок 2: Google Sheet (Таблица) -->
    <div class="sheet-block">
      <h2 class="section-title">Google Sheet</h2>
      <div class="full-table-wrapper">
        <iframe 
          id="liveGoogleSheet"
          src="about:blank" 
          scrolling="auto">
        </iframe>
      </div>
    </div>

  </div>
</section>

<style>
  /* Равномерни разстояния между блоковете */
  .reputation-block,
  .sheet-block {
    margin-bottom: 2rem; /* Равнотно отстояние под всеки блок */
  }

  .sheet-block {
    margin-top: 2.5rem; /* Равнотно отстояние между снимката и следващото заглавие */
  }

  /* Заглавия - намалено долно отстояние спрямо съдържанието */
  .section-title {
    margin-bottom: 1rem !important;
  }

  /* Контейнер за снимката (1000px) */
  .full-image-wrapper {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    background-color: #ffffff;
  }

  .full-size-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    margin: 0 auto;
  }

  /* Контейнер за таблицата (1200px) */
  .full-table-wrapper {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    background-color: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .full-table-wrapper iframe {
    width: 100%;
    height: 550px; 
    border: none;
    display: block;
  }

  /* Мобилна адаптивност */
  @media (max-width: 768px) {
    .sheet-block {
      margin-top: 2rem;
    }
    .full-table-wrapper iframe {
      height: 450px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const iframe = document.getElementById('liveGoogleSheet');
    const baseUrl = "https://docs.google.com/spreadsheets/d/e/2PACX-1vSpsfoa5PWmppRtGeUQV_h0e4f2QpXFKDRRrHnl0yCBwrWCIIaQBo06YvNajSazidWlSxvOQ9Vj-ive/pubhtml";
    
    // Добавяме уникален параметър (timestamp) за предотвратяване на кеша
    const freshUrl = baseUrl + "?widget=false&headers=false&chrome=false&t=" + new Date().getTime();
    
    iframe.src = freshUrl;
  });
</script>
