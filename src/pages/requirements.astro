---
import Base from '../layouts/Base.astro';
const title = 'Requirements & Fleet | TEXIM ONE';
const description = 'What it takes to drive for TEXIM ONE — age and Discord rules, available ranks, and our official truck fleet and skins.';
---
<Base title={title} description={description} active="requirements" path="/requirements.html">
<section class="hero hero--inner"><div class="hero-bg" style="background-image:url('https://i.ibb.co/9mHLkpnw/ets2-20250308-220747-00.png');"></div><div class="hero-overlay"></div><div class="container"><div class="hero-content"><h1 class="hero-title">Requirements</h1><p class="hero-subtitle">Here are our requirements:</p></div></div></section>
<section class="section section--white"><div class="container text-center"><h2 class="section-title">Platforms</h2><p class="section-subtitle">To join us, you need to register, download, and install <a href="https://discord.com/" target="_blank" rel="noopener noreferrer" class="subtitle-link">Discord</a>, <a href="https://trucksbook.eu/" target="_blank" rel="noopener noreferrer" class="subtitle-link">TrucksBook</a>, and <a href="https://truckersmp.com/" target="_blank" rel="noopener noreferrer" class="subtitle-link">TruckersMP</a>. Follow the rules of these platforms and drive with the TrucksBook client running at speeds up to 100 km/h.</p></div></section>
<style>.subtitle-link{color:#0066cc!important;text-decoration:underline!important;font-weight:600}.subtitle-link:hover{color:#004080!important}</style>
<section class="section section--white"><div class="container text-center"><h2 class="section-title">Avatar & Tag</h2><p class="section-subtitle">The <a href="https://i.ibb.co/ynhkwJh9/TEXIM1-AVATAR2026.png" target="_blank" rel="noopener noreferrer" class="subtitle-link">Avatar</a> is used in TruckersMP and TrucksBook, while the <a href="https://i.ibb.co/MxSSQh3T/ets2-20260907-101253-00.png" target="_blank" rel="noopener noreferrer" class="subtitle-link">Tag</a> is used only in TruckersMP.</p></div></section>
<section class="section section--light"><div class="container text-center"><h2 class="section-title">Vehicle Fleet</h2><p class="section-subtitle">Required for formal events.</p><div class="fleet-grid-5">
<div class="fleet-card-item"><div class="fleet-card-header"><div class="fleet-img-wrap"><img src="https://i.ibb.co/zHW7Y4N9/ets2-20260907-093518-00-Photoroom.png" alt="Truck 1" loading="lazy" decoding="async" /></div><span class="fleet-type-badge">Truck</span></div><div class="fleet-card-content"><div class="fleet-info-grid"><div class="fleet-info-row row-series"><span class="fleet-label">Series:</span><span class="fleet-value">Volvo FH6 Aero Globetrotter XL</span></div><div class="fleet-info-row row-engine"><span class="fleet-label">Engine:</span><span class="fleet-value">780 HP</span></div><div class="fleet-info-row row-paint"><span class="fleet-label">Paint Job:</span><span class="fleet-value">Vision</span></div></div></div></div>
<div class="fleet-card-item"><div class="fleet-card-header"><div class="fleet-img-wrap"><img src="https://i.ibb.co/VcshqFQM/ets2-20260907-163057-00-Photoroom.png" alt="Truck 2" loading="lazy" decoding="async" /></div><span class="fleet-type-badge">Truck</span></div><div class="fleet-card-content"><div class="fleet-info-grid"><div class="fleet-info-row row-series"><span class="fleet-label">Series:</span><span class="fleet-value">MAN TGX GX</span></div><div class="fleet-info-row row-engine"><span class="fleet-label">Engine:</span><span class="fleet-value">640 HP</span></div><div class="fleet-info-row row-paint"><span class="fleet-label">Paint Job:</span><span class="fleet-value">Vision</span></div></div></div></div>
<div class="fleet-card-item"><div class="fleet-card-header"><div class="fleet-img-wrap"><img src="https://i.ibb.co/GvTBmKnV/ets2-20260907-163131-00-Photoroom.png" alt="Truck 3" loading="lazy" decoding="async" /></div><span class="fleet-type-badge">Truck</span></div><div class="fleet-card-content"><div class="fleet-info-grid"><div class="fleet-info-row row-series"><span class="fleet-label">Series:</span><span class="fleet-value">Mercedes-Benz New Actros</span></div><div class="fleet-info-row row-engine"><span class="fleet-label">Engine:</span><span class="fleet-value">625 HP</span></div><div class="fleet-info-row row-paint"><span class="fleet-label">Paint Job:</span><span class="fleet-value">Vision</span></div></div></div></div>
<div class="fleet-card-item"><div class="fleet-card-header"><div class="fleet-img-wrap"><img src="https://i.ibb.co/LdKywgSv/ets2-20260907-163114-00-Photoroom.png" alt="Truck 4" loading="lazy" decoding="async" /></div><span class="fleet-type-badge">Truck</span></div><div class="fleet-card-content"><div class="fleet-info-grid"><div class="fleet-info-row row-series"><span class="fleet-label">Series:</span><span class="fleet-value">Scania S High Roof</span></div><div class="fleet-info-row row-engine"><span class="fleet-label">Engine:</span><span class="fleet-value">770 HP</span></div><div class="fleet-info-row row-paint"><span class="fleet-label">Paint Job:</span><span class="fleet-value">Vision</span></div></div></div></div>
<div class="fleet-card-item"><div class="fleet-card-header"><div class="fleet-img-wrap"><img src="https://i.ibb.co/35xSSHx3/ets2-20260907-093526-00-Photoroom.png" alt="Trailer 1" loading="lazy" decoding="async" /></div><span class="fleet-type-badge">Trailer</span></div><div class="fleet-card-content"><div class="fleet-info-grid"><div class="fleet-info-row row-series"><span class="fleet-label">Series:</span><span class="fleet-value">Kässbohrer K.SCS X+</span></div><div class="fleet-info-row row-engine"><span class="fleet-label">Engine:</span><span class="fleet-value">N/A</span></div><div class="fleet-info-row row-paint"><span class="fleet-label">Paint Job:</span><span class="fleet-value">Kässbohrer White Arrow</span></div></div></div></div></div><p class="section-bottom-subtitle">HEX Colors: FFFFFF; 000000; E1E1E1; FF0000. Don't change anything else about the exterior. The Transmission, Interior, and Interior Accessories are optional.</p></div></section>
<style>.fleet-card-header{display:flex!important;flex-direction:column!important;height:170px!important;justify-content:space-between!important;align-items:flex-start!important;width:100%!important;margin-bottom:12px!important;border-bottom:none!important}.fleet-img-wrap{height:125px!important;width:100%!important;display:flex!important;align-items:center!important;justify-content:center!important;border-bottom:none!important}.fleet-img-wrap img{max-height:100%!important;max-width:100%!important;object-fit:contain!important}.fleet-type-badge{align-self:flex-start!important;margin:0!important;border:none!important}.fleet-card-content{display:flex!important;flex-direction:column!important;flex-grow:1!important;border-top:none!important}.fleet-info-grid{display:flex!important;flex-direction:column!important;margin-top:auto!important;width:100%!important;border-top:none!important}.fleet-info-row,.fleet-info-row:last-child{display:flex!important;flex-direction:row!important;justify-content:space-between!important;align-items:center!important;gap:8px!important;border-top:none!important;border-bottom:1px solid #e5e5e5!important;padding:10px 0!important;box-sizing:border-box!important;width:100%!important}.fleet-info-grid>.fleet-info-row:first-child{border-top:none!important;box-shadow:none!important}.row-series{min-height:60px!important}.row-engine{min-height:40px!important}.row-paint{min-height:50px!important}.fleet-label{font-weight:700!important;color:#333!important;font-size:.85rem!important;white-space:nowrap!important;line-height:1.2!important}.fleet-value{font-weight:500!important;color:#111!important;font-size:.8rem!important;text-align:right!important;word-break:break-word!important;line-height:1.2!important}.fleet-grid-5{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;margin-top:24px}.fleet-card-item{display:flex;flex-direction:column;min-width:0;padding:16px;background:#fff;border:1px solid #e1e1e1;border-radius:8px;text-align:left}@media(max-width:1200px){.fleet-grid-5{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:760px){.fleet-grid-5{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.fleet-grid-5{grid-template-columns:1fr}}</style>
<script slot="scripts" src="/js/page-i18n.js" is:inline></script>
</Base>
