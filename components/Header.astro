---
const { active = '' } = Astro.props;
const links = [
  { href: '/', label: 'Home', id: 'home' },
  { href: '/events.html', label: 'Events', id: 'events' },
  { href: '/media.html', label: 'Media', id: 'media' },
  { href: '/partners.html', label: 'Partners', id: 'partners' },
  { href: '/reputation.html', label: 'Reputation', id: 'reputation' },
  { href: '/requirements.html', label: 'Requirements', id: 'requirements' },
  { href: '/apply.html', label: 'Apply', id: 'apply' },
];
---
<header class="header">
  <div class="container header-container">
    <a href="/" class="logo"><img src="https://files.catbox.moe/07u3sd.png" alt="TEXIM ONE" class="logo-img" /></a>
    <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav"><span></span><span></span><span></span></button>
    <nav class="nav" id="mobileNav"><ul class="nav-list">{links.map((link) => (<li><a href={link.href} class={`nav-link${active === link.id ? ' active' : ''}`}>{link.label}</a></li>))}</ul></nav>
  </div>
</header>
<style>
  .logo-img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }
</style>
