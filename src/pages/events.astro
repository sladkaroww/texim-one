---
import Base from '../layouts/Base.astro';

const title = 'Events & Convoy Calendar | TEXIM ONE';
const description = 'Browse the TEXIM ONE convoy calendar, see upcoming convoys in ETS2, and request an invite to join our weekly runs.';
---
<Base title={title} description={description} active="events" path="/events.html">
  <section class="hero hero--inner">
    <div class="hero-bg" style="background-image:url('https://i.ibb.co/d0WGDjhd/viber-2025-03-09-03-14-32-09422.jpg');"></div>
    <div class="hero-overlay"></div>
    <div class="container"><div class="hero-content">
      <h1 class="hero-title">Events</h1>
      <p class="hero-subtitle">All the events we ve been invited to.</p>
    </div></div>
  </section>

  <section class="section" id="invite" style="background-color:#fff;padding-top:1.5rem;padding-bottom:3rem;">
    <div class="container section--narrow">
      <div class="invite-head" style="text-align:center;margin-top:0;margin-bottom:2rem;"><h2 class="section-title" style="margin:0;">Invite Us</h2></div>
      <form id="inviteForm" class="invite-form">
        <div class="form-group"><label for="eventLink">TruckersMP Event Link</label><input type="url" id="eventLink" name="eventLink" placeholder="https://truckersmp.com/events/12345" autocomplete="url" /></div>
        <div class="form-row"><div class="form-group"><label for="eventName">Event Name *</label><input type="text" id="eventName" name="eventName" required /></div><div class="form-group"><label for="eventDate">Event Date *</label><input type="date" id="eventDate" name="eventDate" required /></div></div>
        <div class="form-row"><div class="form-group"><label for="eventTime">Event Time (UTC)</label><input type="time" id="eventTime" name="eventTime" /></div><div class="form-group"><label for="discord">Your Discord *</label><input type="text" id="discord" name="discord" placeholder="name#0000 or @user" required /></div></div>
        <div class="form-group"><label for="email">Email</label><input type="email" id="email" name="email" /></div><div class="form-group"><label for="details">Additional Details</label><textarea id="details" name="details" rows="4"></textarea></div><button type="submit" class="btn btn-primary">Send Invite</button><div id="formMessage" class="form-message"></div>
      </form>
    </div>
  </section>

  <section class="section section--light" style="padding-top:1.5rem;padding-bottom:3rem;"><style is:global>#calendar .event-card,#calendar .calendar-card,#calendar > div{background-color:#fff!important;}</style><div class="container"><div class="section-head" style="text-align:center;margin-top:0;margin-bottom:2rem;"><h2 class="section-title" style="margin:0;">Calendar</h2></div><div id="calendar" class="calendar-grid"><div class="calendar-loading">Loading events...</div></div></div></section>
  <script slot="scripts" src="/js/convoy.js" is:inline></script><script slot="scripts" src="/js/form.js" is:inline></script><script slot="scripts" src="/js/events-db.js" type="module"></script>
</Base>
