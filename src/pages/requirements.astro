---
import Base from '../layouts/Base.astro';

const title = 'Requirements & Fleet | TEXIM ONE';
const description = 'What it takes to drive for TEXIM ONE — age and Discord rules, available ranks, and our official truck fleet and skins.';
---
<Base title={title} description={description} active="requirements" path="/requirements.html">
  <section class="hero hero--inner">
    <div class="hero-bg" style="background-image:url('https://i.ibb.co/9mHLkpnw/ets2-20250308-220747-00.png');"></div>
    <div class="hero-overlay"></div>
    <div class="container"><div class="hero-content">
      <h1 class="hero-title" data-i18n="nav.requirements">Requirements</h1>
      <p class="hero-subtitle" data-i18n="requirements.sub">Corporate Identity.</p>
    </div></div>
  </section>

<section class="section section--white">
  <div class="container text-center">
    
    <!-- Първа подсекция: Platforms -->
    <div class="info-block">
      <h2 class="section-title">Platforms</h2>
      <p class="section-subtitle">
        To join us, you need to register, download, and install 
        <a href="https://discord.com/" target="_blank" rel="noopener noreferrer" class="subtitle-link">Discord</a>, 
        <a href="https://trucksbook.eu/" target="_blank" rel="noopener noreferrer" class="subtitle-link">TrucksBook</a>, and 
        <a href="https://truckersmp.com/" target="_blank" rel="noopener noreferrer" class="subtitle-link">TruckersMP</a>. 
        Follow the rules of these platforms and drive with the TrucksBook client running at speeds up to 100 km/h.
      </p>
    </div>

    <!-- Втора подсекция: Avatar & Tag -->
    <div class="info-block info-block--compact">
      <h2 class="section-title">Avatar & Tag</h2>
      <p class="section-subtitle">
        The <a href="https://i.ibb.co/ynhkwJh9/TEXIM1-AVATAR2026.png" target="_blank" rel="noopener noreferrer" class="subtitle-link">Avatar</a> is used in TruckersMP and TrucksBook, while the <a href="https://i.ibb.co/MxSSQh3T/ets2-20260907-101253-00.png" target="_blank" rel="noopener noreferrer" class="subtitle-link">Tag</a> is used only in TruckersMP.
      </p>
    </div>

  </div>
</section>

<style>
  /* Стил за линковете */
  .subtitle-link {
    color: #0066cc !important;
    text-decoration: underline !important;
    font-weight: 600;
  }

  .subtitle-link:hover {
    color: #004080 !important;
  }

  /* Регулиране на разстоянието между двата блока */
  .info-block--compact {
    margin-top: 1.8rem; /* Намалено разстояние между двата заглавни блока (можете да го регулирате, напр. 1.5rem) */
  }

  /* Намаляване на излишните долни разстояния на самите заглавия */
  .info-block .section-title {
    margin-bottom: 0.5rem;
  }
</style>

<section class="section section--light">
  <div class="container text-center">
    <h2 class="section-title">Vehicle Fleet</h2>
    <p class="section-subtitle">Required for formal events.</p>

    <div class="fleet-grid-5">
      <!-- 1. TRUCK 1 -->
      <div class="fleet-card-item">
        <div class="fleet-card-header">
          <div class="fleet-img-wrap">
            <img src="https://i.ibb.co/spTSjpmK/Chat-GPT-Image-Sep-10-2026-05-02-13-AM.png" alt="Truck 1" loading="lazy" decoding="async" />
          </div>
          <span class="fleet-type-badge">Truck</span>
        </div>
        <div class="fleet-card-content">
          <div class="fleet-info-grid">
            <div class="fleet-info-row row-series">
              <span class="fleet-label">Series:</span>
              <span class="fleet-value">Volvo FH6 Aero Globetrotter XL</span>
            </div>
            <div class="fleet-info-row row-engine">
              <span class="fleet-label">Engine:</span>
              <span class="fleet-value">780 HP</span>
            </div>
            <div class="fleet-info-row row-paint">
              <span class="fleet-label">Paint Job:</span>
              <span class="fleet-value">Vision</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. TRUCK 2 -->
      <div class="fleet-card-item">
        <div class="fleet-card-header">
          <div class="fleet-img-wrap">
            <img src="https://i.ibb.co/jvvdFJzT/Chat-GPT-Image-Sep-10-2026-05-05-01-AM.png" alt="Truck 2" loading="lazy" decoding="async" />
          </div>
          <span class="fleet-type-badge">Truck</span>
        </div>
        <div class="fleet-card-content">
          <div class="fleet-info-grid">
            <div class="fleet-info-row row-series">
              <span class="fleet-label">Series:</span>
              <span class="fleet-value">MAN TGX GX</span>
            </div>
            <div class="fleet-info-row row-engine">
              <span class="fleet-label">Engine:</span>
              <span class="fleet-value">640 HP</span>
            </div>
            <div class="fleet-info-row row-paint">
              <span class="fleet-label">Paint Job:</span>
              <span class="fleet-value">Vision</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. TRUCK 3 -->
      <div class="fleet-card-item">
        <div class="fleet-card-header">
          <div class="fleet-img-wrap">
            <img src="https://i.ibb.co/0j48TZL6/Chat-GPT-Image-Sep-10-2026-05-04-05-AM.png" alt="Truck 3" loading="lazy" decoding="async" />
          </div>
          <span class="fleet-type-badge">Truck</span>
        </div>
        <div class="fleet-card-content">
          <div class="fleet-info-grid">
            <div class="fleet-info-row row-series">
              <span class="fleet-label">Series:</span>
              <span class="fleet-value">Mercedes-Benz New Actros</span>
            </div>
            <div class="fleet-info-row row-engine">
              <span class="fleet-label">Engine:</span>
              <span class="fleet-value">625 HP</span>
            </div>
            <div class="fleet-info-row row-paint">
              <span class="fleet-label">Paint Job:</span>
              <span class="fleet-value">Vision</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. TRUCK 4 -->
      <div class="fleet-card-item">
        <div class="fleet-card-header">
          <div class="fleet-img-wrap">
            <img src="https://i.ibb.co/60ccp7Qj/Chat-GPT-Image-Sep-10-2026-05-03-19-AM.png" alt="Truck 4" loading="lazy" decoding="async" />
          </div>
          <span class="fleet-type-badge">Truck</span>
        </div>
        <div class="fleet-card-content">
          <div class="fleet-info-grid">
            <div class="fleet-info-row row-series">
              <span class="fleet-label">Series:</span>
              <span class="fleet-value">Scania S High Roof</span>
            </div>
            <div class="fleet-info-row row-engine">
              <span class="fleet-label">Engine:</span>
              <span class="fleet-value">770 HP</span>
            </div>
            <div class="fleet-info-row row-paint">
              <span class="fleet-label">Paint Job:</span>
              <span class="fleet-value">Vision</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. TRAILER -->
      <div class="fleet-card-item">
        <div class="fleet-card-header">
          <div class="fleet-img-wrap">
            <img src="https://i.ibb.co/5WMsY0P3/Chat-GPT-Image-Sep-10-2026-05-01-34-AM.png" alt="Trailer 1" loading="lazy" decoding="async" />
          </div>
          <span class="fleet-type-badge">Trailer</span>
        </div>
        <div class="fleet-card-content">
          <div class="fleet-info-grid">
            <div class="fleet-info-row row-series">
              <span class="fleet-label">Series:</span>
              <span class="fleet-value">Kässbohrer K.SCS X+</span>
            </div>
            <div class="fleet-info-row row-engine">
              <span class="fleet-label">Engine:</span>
              <span class="fleet-value">N/A</span>
            </div>
            <div class="fleet-info-row row-paint">
              <span class="fleet-label">Paint Job:</span>
              <span class="fleet-value">Kässbohrer White Arrow</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="section-bottom-subtitle">HEX Colors: FFFFFF; 000000; E1E1E1; FF0000. Don't change anything else about the exterior. The Transmission, Interior, and Interior Accessories are optional.</p>
  </div>
</section>

<style>
  .fleet-card-header {
    display: flex !important;
    flex-direction: column !important;
    height: 170px !important;
    justify-content: space-between !important;
    align-items: flex-start !important;
    width: 100% !important;
    margin-bottom: 12px !important;
    border-bottom: none !important;
  }

  .fleet-img-wrap {
    height: 125px !important;
    width: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border-bottom: none !important;
  }

  .fleet-img-wrap img {
    max-height: 100% !important;
    max-width: 100% !important;
    object-fit: contain !important;
  }

  .fleet-type-badge {
    align-self: flex-start !important;
    margin: 0 !important;
    border: none !important;
    border-bottom: none !important;
  }

  .fleet-card-content {
    display: flex !important;
    flex-direction: column !important;
    flex-grow: 1 !important;
    border-top: none !important;
  }

  .fleet-info-grid {
    display: flex !important;
    flex-direction: column !important;
    margin-top: auto !important;
    width: 100% !important;
    border-top: none !important;
  }

  /* Основни стилове за всички редове */
  .fleet-info-row {
    display: flex !important;
    flex-direction: row !important;
    justify-content: space-between !important;
    align-items: center !important;
    gap: 8px !important;
    border-top: none !important; /* Премахва горна линия */
    border-bottom: 1px solid #e5e5e5 !important;
    padding: 10px 0 !important;
    box-sizing: border-box !important;
    width: 100% !important;
  }

  /* ГАРАНТИРАНО премахване на линията под TRUCK / TRAILER и над Series */
  .fleet-info-row.row-series,
  .fleet-info-grid > .fleet-info-row:first-child {
    border-top: none !important;
    box-shadow: none !important;
  }

  .row-series {
    min-height: 60px !important;
  }

  .row-engine {
    min-height: 40px !important;
  }

  .row-paint {
    min-height: 50px !important;
  }

  .fleet-label {
    font-weight: 700 !important;
    color: #333333 !important;
    font-size: 0.85rem !important;
    white-space: nowrap !important;
    line-height: 1.2 !important;
  }

  .fleet-value {
    font-weight: 500 !important;
    color: #111111 !important;
    font-size: 0.8rem !important;
    text-align: right !important;
    word-break: break-word !important;
    line-height: 1.2 !important;
  }
</style>

