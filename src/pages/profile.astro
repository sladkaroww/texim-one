---
import Base from '../layouts/Base.astro';
---
<Base title="My Profile | TEXIM ONE" description="Manage your TEXIM ONE member profile." active="" path="/profile.html" robots="noindex,nofollow">
  <section class="account-page"><div class="container"><div class="account-card">
    <div class="profile-head"><img id="profileAvatar" class="avatar" src="https://static.truckersmp.com/avatarsN/4710545.1766443403.png" alt="Profile avatar" /><div><h1 class="account-title">My Profile</h1><div id="profileEmail" class="account-muted"></div><span id="profileRole" class="badge">member</span></div></div>
    <form id="profileForm" class="account-form">
      <label>Username<input id="username" name="username" type="text" minlength="3" maxlength="30" required /></label>
      <label>Display name<input id="display_name" name="display_name" type="text" maxlength="60" required /></label>
      <div class="account-actions"><button class="btn btn-primary" type="submit">Save profile</button><a class="btn" href="/logout.html">Log out</a></div>
      <div id="accountMessage" class="account-message" role="status"></div>
    </form>
    <div class="account-danger-zone">
      <button id="deleteProfileButton" class="delete-profile-button" type="button">Delete profile</button>
      <p class="delete-profile-hint">Permanently delete your TEXIM ONE account and profile.</p>
    </div>
  </div></div></section>

  <div id="deleteProfileModal" class="delete-modal" hidden aria-hidden="true">
    <div class="delete-modal-backdrop" data-delete-close></div>
    <div class="delete-modal-card" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
      <button class="delete-modal-close" type="button" aria-label="Close" data-delete-close>×</button>
      <div class="delete-modal-icon">!</div>
      <h2 id="deleteModalTitle">Delete your profile?</h2>
      <p>This action is <strong>irreversible</strong>. Your TEXIM ONE account and profile will be permanently deleted.</p>
      <p class="delete-modal-instruction">To confirm, press and hold the button for 3 seconds.</p>
      <button id="confirmDeleteButton" class="hold-delete-button" type="button">
        <span class="hold-delete-progress"></span>
        <span class="hold-delete-label">Press and hold to delete</span>
      </button>
      <button class="delete-modal-cancel" type="button" data-delete-close>Cancel</button>
    </div>
  </div>

  <script slot="scripts" src="/js/account.js" type="module"></script>
</Base>
