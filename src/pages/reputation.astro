---
import Base from '../layouts/Base.astro';

const title = 'The Power of Authority | TEXIM ONE';
const description = 'Build your reputation, raise your standing, and set the direction for the community.';
---
<Base title={title} description={description} active="reputation" path="/reputation.html">
  <section class="hero hero--inner">
    <div class="hero-bg" style="background-image:url('https://i.ibb.co/CKpZkbnP/ets2-20250308-220351-00.png');"></div>
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title" data-i18n="nav.ranks">Reputation</h1>
        <p class="hero-subtitle" data-i18n="ranks.sub">The Power of Authority.</p>
      </div>
    </div>
  </section>

<section class="section section--white custom-tight-section">
  <div class="container text-center">
    
    <!-- Блок 1: Reputation System (Снимка) -->
    <div class="reputation-block">
      <h2 class="section-title">Reputation System</h2>
      <div class="full-image-wrapper">
        <img 
          src="https://i.ibb.co/2708PT5b/Gemini-Generated-Image-r121lrr121lrr121.jpg" 
          alt="Reputation Points" 
          class="full-size-image"
        />
      </div>
    </div>

    <!-- Блок 2: Mods (Нова секция с заглавие и описание) -->
    <div class="mods-block">
      <h2 class="section-title">Paid Modifications</h2>
      <p class="mods-description">
        Once you reach Level 1, we will provide you with the paid mods 
        <a href="#" class="mod-link" target="_blank" rel="https://www.jbxgraphicsmods.com/">JBX Graphics 2</a>, 
        <a href="#" class="mod-link" target="_blank" rel="https://store.n-artworks.workers.dev/we">PNG: WinterExperience</a>, and 
        <a href="#" class="mod-link" target="_blank" rel="https://alaskamod.com/">Alaska - North to the Future</a>.
      </p>
    </div>

    <!-- Блок 3: Google Sheet (Таблица) -->
    <div class="sheet-block">
      <h2 class="section-title">Google Sheet</h2>
      <div class="full-table-wrapper">
        <iframe 
          id="liveGoogleSheet"
          src="about:blank" 
          scrolling="auto">
        </iframe>
      </div>
    </div>

  </div>
</section>

<style>
  /* Намаляване и изравняване на отстоянията най-отгоре и най-отдолу на секцията */
  .custom-tight-section {
    padding-top: 1.5rem !important;    /* Намалено отстояние над първото заглавие */
    padding-bottom: 1.5rem !important; /* Намалено отстояние под таблицата */
  }

  /* Разстояние между отделните блокове */
  .mods-block,
  .sheet-block {
    margin-top: 2rem;
  }

  /* Отстояние под заглавията */
  .section-title {
    margin-bottom: 0.8rem !important;
  }

  /* Стил за описанието в секция Mods */
  .mods-description {
    color: #000000;             /* Изцяло черен цвят */
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 900px;
    margin: 0 auto;             /* Центриране на блока с текст */
    font-weight: 400;
  }

  /* Стил за линковете на модовете */
  .mods-description .mod-link {
    color: #000000;             /* Запазва черния цвят */
    font-weight: 600;           /* В удебелен шрифт за по-добра видимост */
    text-decoration: underline; /* Подчертаване, за да личи, че са линкове */
    transition: opacity 0.2s ease;
  }

  .mods-description .mod-link:hover {
    opacity: 0.7;               /* Лек ефект при посочване с мишката */
  }

  /* Контейнер за снимката (1000px) */
  .full-image-wrapper {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    background-color: #ffffff;
  }

  .full-size-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    margin: 0 auto;
  }

  /* Контейнер за таблицата (1200px) */
  .full-table-wrapper {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    background-color: #ffffff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .full-table-wrapper iframe {
    width: 100%;
    height: 550px; 
    border: none;
    display: block;
  }

  /* Мобилна адаптивност */
  @media (max-width: 768px) {
    .custom-tight-section {
      padding-top: 1rem !important;
      padding-bottom: 1rem !important;
    }
    .full-table-wrapper iframe {
      height: 450px;
    }
    .mods-description {
      font-size: 1rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const iframe = document.getElementById('liveGoogleSheet');
    const baseUrl = "https://docs.google.com/spreadsheets/d/e/2PACX-1vSpsfoa5PWmppRtGeUQV_h0e4f2QpXFKDRRrHnl0yCBwrWCIIaQBo06YvNajSazidWlSxvOQ9Vj-ive/pubhtml";
    
    // Добавяме уникален параметър (timestamp) за предотвратяване на кеша
    const freshUrl = baseUrl + "?widget=false&headers=false&chrome=false&t=" + new Date().getTime();
    
    iframe.src = freshUrl;
  });
</script>
