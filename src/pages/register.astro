---
import Base from '../layouts/Base.astro';
---
<Base title="Register | TEXIM ONE" description="Create your TEXIM ONE member account." path="/register.html">
  <section class="account-page"><div class="container"><div class="account-card account-card--narrow">
    <h1 class="account-title">Create Account</h1><p class="account-muted">Become part of the TEXIM ONE member system.</p>
    <form id="registerForm" class="account-form">
      <label>Username<input name="username" type="text" minlength="3" maxlength="30" autocomplete="username" required /></label>
      <label>Email<input name="email" type="email" autocomplete="email" required /></label>
      <label>Password<input name="password" type="password" minlength="8" autocomplete="new-password" required /></label>
      <button class="btn btn-primary" type="submit">Register</button>
      <div id="accountMessage" class="account-message" role="status"></div>
    </form>
    <p class="account-muted">Already a member? <a class="account-link" href="/login.html">Log in</a></p>
  </div></div></section>
  <script slot="scripts" src="/js/account.js" type="module"></script>
</Base>
